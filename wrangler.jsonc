// Cloudflare Workers — static assets only (no Worker script, no server code).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marioschoch-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a real 404 status for unknown paths.
    "not_found_handling": "404-page",
    // /about → /about/ (matches Astro's directory build format and canonical URLs).
    "html_handling": "force-trailing-slash"
  }
}
