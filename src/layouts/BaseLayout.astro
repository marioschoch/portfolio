---
/**
 * Base HTML shell used by every page: head/SEO, fonts, theme, header, footer,
 * command palette and (in production) Cloudflare Web Analytics.
 */
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Seo, { type Props as SeoProps } from '@/components/Seo.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import { site } from '@/data/site';
import { locales, useTranslations } from '@/i18n/utils';

type Props = SeoProps;
const props = Astro.props;
const { lang, translated = true } = props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={locales[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e2e2e2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1112" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font
      cssVariable="--font-plex-sans"
      preload={[{ weight: '400', style: 'normal', subset: 'latin' }]}
    />
    <Font cssVariable="--font-plex-mono" />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 bg-accent px-4 py-3 text-small text-accent-ink focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} />
    {!translated && lang !== 'en' && (
      <div class="no-print bg-surface">
        <p class="container-page py-3 text-small" lang={locales[lang]}>
          {t('fallback.notice')}
        </p>
      </div>
    )}
    <main
      id="main"
      class="flex-1 pb-24 sm:pb-32 lg:pb-40 has-[>[data-flush]:last-child]:pb-0"
      lang={translated ? undefined : locales.en}
    >
      <slot />
    </main>
    <Footer lang={lang} />
    <CommandPalette lang={lang} />
    {import.meta.env.PROD && site.analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
      />
    )}
    <script>
      // Section parts rise into place once as they enter the viewport (see global.css).
      const parts = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        parts.forEach((el) => io.observe(el));
      } else {
        parts.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
