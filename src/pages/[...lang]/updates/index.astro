---
/** Global updates feed: every project log entry, newest first, grouped by year. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Timeline from '@/components/Timeline.astro';
import { getProjects, getUpdates } from '@/lib/content';
import { langPaths, useTranslations, type Lang } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const updates = await getUpdates();
const projectTitles = Object.fromEntries((await getProjects(lang)).map((p) => [p.id, p.title]));
const years = [...new Set(updates.map((u) => u.data.date.getUTCFullYear()))];
---

<BaseLayout lang={lang} title={t('updates.title')} description={t('updates.intro')}>
  <PageHeader
    label={`${String(updates.length).padStart(2, '0')} / ${t('updates.title')}`}
    title={t('updates.title')}
    intro={t('updates.intro')}
  >
    <a href="/rss.xml" class="btn mt-6">
      <svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
        <circle cx="3" cy="13" r="2"></circle>
        <path d="M1 6.5A8.5 8.5 0 0 1 9.5 15H7a6 6 0 0 0-6-6V6.5Zm0-5A13.5 13.5 0 0 1 14.5 15H12A11 11 0 0 0 1 4V1.5Z"></path>
      </svg>
      {t('updates.rss')}
    </a>
  </PageHeader>

  <div class="container-page space-y-14 py-12">
    {years.map((year) => (
      <section class="grid gap-6 sm:grid-cols-[6rem_minmax(0,1fr)]" aria-labelledby={`y-${year}`}>
        <h2 id={`y-${year}`} class="font-mono text-sm text-muted sm:pt-0.5">
          {year}
        </h2>
        <div class="max-w-text">
          <Timeline
            updates={updates.filter((u) => u.data.date.getUTCFullYear() === year)}
            lang={lang}
            projectTitles={projectTitles}
          />
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
