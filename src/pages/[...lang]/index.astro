---
/**
 * Home: the name set across the full grid, the photo and links below it; then Now (the one
 * inverted section), featured projects as a numbered index with the cover of the active row in
 * the label column, and latest updates.
 */
import { Image, Picture } from 'astro:assets';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { getFeaturedProjects, getProjects, getUpdates, updateTeaser } from '@/lib/content';
import { personJsonLd } from '@/lib/person';
import { site } from '@/data/site';
import { now } from '@/data/now';
import { tx } from '@/data/cv';
import heroImage from '@/assets/home/hero-cycling.jpg';
import {
  formatDate,
  isoDate,
  langPaths,
  localizePath,
  useTranslations,
  type Lang,
} from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const featured = await getFeaturedProjects(lang, 3);
const projectTitles = Object.fromEntries((await getProjects(lang)).map((p) => [p.id, p.title]));
const latest = (await getUpdates()).slice(0, 3);
const nowDate = new Date(`${now.updated}T00:00:00Z`);
/** Row numbers of the project index: 01, 02 … */
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout
  lang={lang}
  title={site.status[lang]}
  description={site.tagline[lang]}
  jsonLd={personJsonLd}
>
  <!-- Intro: the name across all twelve columns, then label column, tagline and photo -->
  <section class="container-page overflow-x-clip pt-8 pb-16 md:pt-12 md:pb-24">
    <div class="grid-page">
      <figure class="row-start-3 mt-6 md:col-span-3 md:col-start-10 md:row-span-2 md:row-start-3 md:mt-4">
        <Picture
          src={heroImage}
          alt={t('home.photoAlt')}
          widths={[480, 720, 960, 1300]}
          sizes="(min-width: 768px) 25vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover object-[28%_50%]"
        />
      </figure>
      <h1 class="hero-name md:row-start-1">{site.name}</h1>
      <div class="mt-6 border-t border-rule md:row-start-2" aria-hidden="true"></div>
      <div class="mt-4 md:col-span-6 md:col-start-4 md:row-start-3">
        <p class="max-w-[24ch] heading">{site.tagline[lang]}</p>
        {site.availableFrom && (
          <p class="mt-4">
            {t('home.openTo')} {site.availableFrom[lang]}
          </p>
        )}
      </div>
      <p class="mt-6 label md:col-span-3 md:col-start-1 md:row-start-3 md:mt-4">
        {tx(site.location, lang)}
        <span aria-hidden="true"> · </span>
        {t('home.photoCredit')} Lars Meier
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 md:col-span-6 md:col-start-4 md:row-start-4 md:mt-12 md:self-end">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            <a href={site.links.github} class="link" rel="me noopener">
              GitHub ↗
            </a>
          </li>
          <li>
            <a href={site.links.linkedin} class="link" rel="me noopener">
              LinkedIn ↗
            </a>
          </li>
          <li>
            <ObfuscatedEmail class="link" label={t('contact.email')} />
          </li>
        </ul>
        <a href={localizePath('/cv/', lang)} class="btn btn-primary">
          {t('nav.cv')} →
        </a>
      </div>
    </div>
  </section>

  <!-- Now: the one inverted section -->
  <section class="bg-fg text-bg" aria-labelledby="now-heading">
    <div class="container-page grid-page gap-y-6 py-12 md:py-16">
      <div class="md:col-span-3">
        <h2 id="now-heading" class="section-title">
          {t('home.now')}
        </h2>
        <p class="mt-2 text-small text-invert-muted">
          {t('home.nowUpdated')}{' '}
          <time datetime={isoDate(nowDate)}>{formatDate(nowDate, lang)}</time>
        </p>
      </div>
      <ul class="space-y-4 md:col-span-8 md:col-start-4 md:pt-6">
        {now.items.map((item) => (
          <li class="max-w-[32ch] heading">{tx(item, lang)}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured projects: a numbered index; the active row's cover sits in the label column -->
  {featured.length > 0 && (
    <section class="container-page section" aria-labelledby="featured-heading" data-work>
      <div class="grid-page gap-y-8 border-t border-rule pt-4">
        <h2 id="featured-heading" class="section-title md:col-span-3">
          {t('home.featured')}
        </h2>
        <a
          href={localizePath('/projects/', lang)}
          class="link justify-self-start md:col-span-3 md:col-start-10 md:row-start-1 md:mt-6"
        >
          {t('home.allProjects')} →
        </a>
        <ol class="grid grid-cols-subgrid content-start self-start border-t border-rule md:col-span-9 md:col-start-4 md:row-start-2">
          {featured.map((p, i) => (
            <li class="col-span-full grid grid-cols-subgrid border-b border-rule">
              <div class="col-span-full pt-4 md:hidden">
                {p.cover ? (
                  <Image
                    src={p.cover.src}
                    alt={p.cover.alt}
                    widths={[480, 720, 960]}
                    sizes="100vw"
                    class="aspect-[16/10] w-full object-cover"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <ImagePlaceholder label={t('project.imagePending')} />
                )}
              </div>
              <a
                href={localizePath(`/projects/${p.id}/`, lang)}
                class="work-row col-span-full grid grid-cols-subgrid gap-y-2 py-4 md:py-6"
                data-work-row={i}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span class="num pt-1 md:pt-2" aria-hidden="true">
                  {pad(i)}
                </span>
                <span class="work-title col-span-3 heading md:col-span-5">{p.title}</span>
                <span class="col-span-3 col-start-2 label md:col-span-3 md:col-start-7 md:pt-2">
                  {p.entry.data.tags.map((tag) => t(`tag.${tag}`)).join(', ')} ·{' '}
                  {p.entry.data.timeframe.start.getUTCFullYear()}
                </span>
              </a>
            </li>
          ))}
        </ol>
        <div class="hidden md:col-span-3 md:col-start-1 md:row-start-2 md:block">
          <div class="sticky top-[calc(var(--header-h)+2rem)] aspect-[4/5] bg-surface">
            {featured.map((p, i) =>
              p.entry.data.cover ? (
                <Image
                  src={p.entry.data.cover.src}
                  alt=""
                  widths={[480, 720]}
                  sizes="25vw"
                  class="work-frame absolute inset-0 size-full object-cover"
                  data-work-frame={i}
                  data-active={i === 0 ? 'true' : undefined}
                />
              ) : (
                <ImagePlaceholder
                  label={t('project.imagePending')}
                  class="work-frame absolute! inset-0 aspect-auto! size-full"
                  data-work-frame={i}
                  data-active={i === 0 ? 'true' : undefined}
                />
              ),
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Latest updates: dates in the label column, the entries on the right -->
  {latest.length > 0 && (
    <section class="container-page section" aria-labelledby="latest-heading">
      <div class="grid-page gap-y-8 border-t border-rule pt-4">
        <h2 id="latest-heading" class="section-title md:col-span-3">
          {t('home.latest')}
        </h2>
        <ol class="grid grid-cols-subgrid content-start self-start border-t border-rule md:col-span-9 md:col-start-4">
          {latest.map((u) => (
            <li class="group relative col-span-full grid grid-cols-subgrid gap-y-1 border-b border-rule py-4 md:py-6">
              <p class="col-span-full label md:col-span-3">
                <time datetime={isoDate(u.data.date)}>{formatDate(u.data.date, lang)}</time>
                <span class="block">{projectTitles[u.data.project.id]}</span>
              </p>
              <div class="col-span-full md:col-span-6">
                <h3 class="text-lead font-medium">
                  <a
                    href={localizePath(`/projects/${u.data.project.id}/`, lang) + `#${u.id}`}
                    class="link-quiet after:absolute after:inset-0"
                  >
                    {u.data.title}
                  </a>
                </h3>
                <p class="mt-2 max-w-[60ch]">{updateTeaser(u, 160)}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  @reference '../../styles/global.css';

  /* The name fills the content width: it measures 5.46 em (Inter Tight 500 at -0.045em tracking,
     side bearings included) on one line, and "Schoch", the longer word, 3.04 em when it breaks
     on phones. */
  .hero-name {
    --k: 3.04;
    font-size: calc((min(100vw, 96rem) - 2 * var(--margin)) / var(--k));
    line-height: 0.84;
    letter-spacing: -0.045em;
    margin-left: -0.055em;
  }
  @media (width >= 48rem) {
    .hero-name {
      --k: 5.46;
      white-space: nowrap;
    }
  }

  /* Index: the active row (pointer or focus, the first one by default) has its title in red. */
  .work-row[aria-current='true'] .work-title {
    @apply md:text-accent;
  }
  .work-title {
    @apply transition-colors duration-150;
  }
  .work-frame {
    visibility: hidden;
  }
  .work-frame[data-active='true'] {
    visibility: visible;
  }
</style>

<script>
  // Project index: pointing at or focusing a name shows its picture in the fixed frame.
  for (const work of document.querySelectorAll<HTMLElement>('[data-work]')) {
    const rows = [...work.querySelectorAll<HTMLElement>('[data-work-row]')];
    const frames = [...work.querySelectorAll<HTMLElement>('[data-work-frame]')];
    const activate = (i: number) => {
      rows.forEach((r, j) =>
        j === i ? r.setAttribute('aria-current', 'true') : r.removeAttribute('aria-current'),
      );
      frames.forEach((f, j) => (j === i ? (f.dataset.active = 'true') : delete f.dataset.active));
    };
    rows.forEach((row, i) => {
      row.addEventListener('pointerenter', () => activate(i));
      row.addEventListener('focus', () => activate(i));
    });
  }
</script>
