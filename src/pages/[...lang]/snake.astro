---
/**
 * Snake: a small canvas game. Keyboard (arrows / WASD / Space) on desktop,
 * swipe or on-screen buttons on touch devices. Colours follow the site theme.
 * The snake is drawn as a roller chain and the food as a turning gear; sounds are
 * synthesised with the Web Audio API (no audio files) and can be muted.
 * The shared top-10 board is served by public/api/snake-scores.php.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { langPaths, useTranslations, type Lang } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const strings = {
  start: t('snake.start'),
  again: t('snake.again'),
  resume: t('snake.resume'),
  paused: t('snake.paused'),
  gameOver: t('snake.gameOver'),
  score: t('snake.score'),
  boardEmpty: t('snake.boardEmpty'),
  boardError: t('snake.boardError'),
  nameFirst: t('snake.nameFirst'),
  nameChange: t('snake.nameChange'),
  nameTaken: t('snake.nameTaken'),
  nameError: t('snake.nameError'),
  rank: t('snake.rank'),
  try: t('snake.try'),
  tries: t('snake.tries'),
  saveError: t('snake.saveError'),
};

const pad = [
  { dir: 'up', label: t('snake.up'), d: 'M8 3 3 11h10z' },
  { dir: 'left', label: t('snake.left'), d: 'M3 8l8-5v10z' },
  { dir: 'right', label: t('snake.right'), d: 'M13 8 5 3v10z' },
  { dir: 'down', label: t('snake.down'), d: 'M8 13 3 5h10z' },
];
---

<BaseLayout lang={lang} title={t('snake.title')} description={t('snake.intro')}>
  <PageHeader title={t('snake.title')} intro={t('snake.intro')} />

  <div class="container-page grid-page gap-y-16">
    <div
      id="snake"
      class="w-full max-w-md select-none md:col-span-7 md:max-w-none lg:col-span-5"
      data-strings={JSON.stringify(strings)}
    >
      <div class="mb-4 flex items-center justify-between gap-4 border-t border-rule pt-2">
        <p>
          <span class="label">{t('snake.score')}</span>
          <span id="snake-score" class="ml-2 text-lead font-medium tabular-nums">
            0
          </span>
        </p>
        <p>
          <span class="label">{t('snake.best')}</span>
          <span id="snake-best" class="ml-2 text-lead font-medium tabular-nums">
            0
          </span>
        </p>
        <button
          type="button"
          id="snake-sound"
          class="btn ml-auto size-10 min-h-10 touch-manipulation p-0"
          aria-label={t('snake.sound')}
          aria-pressed="true"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2.5 7h3l4-3.5v11l-4-3.5h-3z" fill="currentColor"></path>
            <path
              class="sound-on"
              d="M12.5 6.5a3.5 3.5 0 0 1 0 5M14.5 4.5a6.5 6.5 0 0 1 0 9"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            ></path>
            <path
              class="sound-off hidden"
              d="m12 7 4 4m0-4-4 4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
        <button
          type="button"
          id="snake-pause"
          class="btn min-h-10 touch-manipulation px-4 text-small disabled:pointer-events-none disabled:opacity-50"
          disabled
        >
          {t('snake.pause')}
        </button>
      </div>

      <div
        id="snake-board"
        class="relative aspect-square w-full touch-none overflow-hidden bg-surface"
      >
        <canvas
          id="snake-canvas"
          class="absolute inset-0 size-full"
          role="img"
          aria-label="Snake"
        ></canvas>
        <div
          id="snake-overlay"
          class="absolute inset-0 flex flex-col items-start justify-end gap-4 bg-surface/90 p-6"
        >
          <p id="snake-message" class="heading" aria-live="polite">
            Snake
          </p>
          <form id="snake-entry" class="hidden w-full max-w-xs" autocomplete="off">
            <label id="snake-name-label" for="snake-name" class="block" aria-live="polite">
              {t('snake.nameFirst')}
            </label>
            <div class="mt-2 flex gap-2">
              <input
                id="snake-name"
                name="name"
                type="text"
                maxlength="12"
                required
                placeholder={t('snake.name')}
                class="min-h-11 min-w-0 flex-1 border border-rule bg-bg px-2 text-body text-fg placeholder:text-muted"
              />
              <button type="submit" class="btn btn-primary min-h-11 px-4">
                {t('snake.save')}
              </button>
            </div>
            <button
              type="button"
              id="snake-name-cancel"
              class="mt-2 text-small text-fg underline decoration-1 underline-offset-[0.2em] hover:decoration-accent"
            >
              {t('snake.cancel')}
            </button>
          </form>
          <button type="button" id="snake-action" class="btn btn-primary touch-manipulation px-8">
            {t('snake.start')}
          </button>
        </div>
      </div>

      <div
        class="mt-4 hidden w-48 grid-cols-3 gap-2 pointer-coarse:grid"
        style="grid-template-areas: '. up .' 'left down right'"
      >
        {pad.map((b) => (
          <button
            type="button"
            data-dir={b.dir}
            aria-label={b.label}
            style={`grid-area: ${b.dir}`}
            class="flex aspect-square touch-manipulation items-center justify-center border border-rule text-fg active:bg-fg active:text-bg"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d={b.d} fill="currentColor"></path>
            </svg>
          </button>
        ))}
      </div>

      <p id="snake-player" class="mt-6 hidden text-small">
        {t('snake.playingAs')} <strong id="snake-player-name" class="font-semibold"></strong>
        {' · '}
        <button
          type="button"
          id="snake-rename"
          class="underline decoration-1 underline-offset-[0.2em] hover:decoration-accent"
        >
          {t('snake.change')}
        </button>
      </p>
      <p class="mt-6 label">{t('snake.help')}</p>
    </div>

    <section
      class="border-t border-rule pt-2 md:col-span-4 md:col-start-9 lg:col-start-8"
      aria-labelledby="board-heading"
    >
      <h2 id="board-heading" class="heading">
        {t('snake.board')}
      </h2>
      <ol
        id="snake-scores"
        class="mt-6 hidden list-decimal border-t border-rule pl-8 marker:tabular-nums"
      ></ol>
      <p id="snake-board-status" class="mt-6 text-muted" aria-live="polite">
        {t('snake.boardLoading')}
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  type Dir = 'up' | 'down' | 'left' | 'right';
  type Cell = { x: number; y: number };
  type State = 'ready' | 'running' | 'paused' | 'over';

  const GRID = 20;
  const START_INTERVAL = 140; // ms per step
  const RESTART_DELAY = 800; // ms after a crash before game keys can restart
  const MIN_INTERVAL = 70;
  const BEST_KEY = 'snake-best';
  const VEC: Record<Dir, Cell> = {
    up: { x: 0, y: -1 },
    down: { x: 0, y: 1 },
    left: { x: -1, y: 0 },
    right: { x: 1, y: 0 },
  };
  const OPPOSITE: Record<Dir, Dir> = { up: 'down', down: 'up', left: 'right', right: 'left' };
  const KEYS: Record<string, Dir> = {
    ArrowUp: 'up',
    ArrowDown: 'down',
    ArrowLeft: 'left',
    ArrowRight: 'right',
    w: 'up',
    s: 'down',
    a: 'left',
    d: 'right',
  };

  // ---------------------------------------------------------------------------
  // Shared leaderboard
  // ---------------------------------------------------------------------------
  type Entry = { name: string; score: number; tries: number; date: string };
  type Result = { name: string; scores: Entry[]; rank: number | null };
  const API = '/api/snake-scores.php';
  /** A random ID that makes this browser the owner of its name on the board. */
  const PLAYER_KEY = 'snake-player';
  /** The name, once the player has chosen it. */
  const PLAYER_NAME_KEY = 'snake-player-name';
  /** A name typed on the earlier board, offered as the first suggestion. */
  const OLD_NAME_KEY = 'snake-name';

  const storage = {
    get(key: string) {
      try {
        return localStorage.getItem(key);
      } catch {
        return null; // storage unavailable (private mode)
      }
    },
    set(key: string, value: string) {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* ignore */
      }
    },
  };

  const api = async (body?: object) => {
    const res = await fetch(API, {
      method: body ? 'POST' : 'GET',
      headers: body ? { 'Content-Type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    if (!res.ok) throw Object.assign(new Error(`HTTP ${res.status}`), { status: res.status });
    return res.json();
  };
  /** The server answers 409 when a name belongs to another player. */
  const isTaken = (e: unknown) => (e as { status?: number }).status === 409;

  const leaderboard = {
    list: document.getElementById('snake-scores') as HTMLOListElement | null,
    status: document.getElementById('snake-board-status'),
    scores: null as Entry[] | null,
    token: null as string | null,
    texts: {} as Record<string, string>,
    player: '',
    name: '',

    /** Load this browser's player ID (creating one) and saved name. */
    init() {
      this.player = storage.get(PLAYER_KEY) ?? '';
      if (!/^[0-9a-f]{32}$/.test(this.player)) {
        this.player = Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) =>
          b.toString(16).padStart(2, '0'),
        ).join('');
        storage.set(PLAYER_KEY, this.player);
      }
      this.name = storage.get(PLAYER_NAME_KEY) ?? '';
    },

    setName(name: string) {
      this.name = name;
      storage.set(PLAYER_NAME_KEY, name);
    },

    render() {
      if (!this.list || !this.status || !this.scores) return;
      const me = this.name.toLowerCase();
      this.list.replaceChildren(
        ...this.scores.map((entry) => {
          const li = document.createElement('li');
          li.className = 'border-b border-rule py-2 pl-2 aria-[current=true]:font-medium';
          if (me && entry.name.toLowerCase() === me) li.setAttribute('aria-current', 'true');
          const row = document.createElement('span');
          row.className = 'flex items-baseline gap-4';
          const name = document.createElement('span');
          name.className = 'min-w-0 flex-1 truncate text-lead';
          name.textContent = entry.name;
          const tries = document.createElement('span');
          tries.className = 'shrink-0 text-small font-normal text-muted tabular-nums';
          tries.textContent = `${entry.tries} ${(entry.tries === 1 ? this.texts.try : this.texts.tries) ?? ''}`;
          const score = document.createElement('span');
          score.className = 'min-w-[3ch] shrink-0 text-right text-lead tabular-nums';
          score.textContent = String(entry.score);
          row.append(name, tries, score);
          li.append(row);
          return li;
        }),
      );
      this.list.classList.toggle('hidden', this.scores.length === 0);
      this.status.textContent = this.scores.length ? '' : (this.texts.boardEmpty ?? '');
    },

    async load() {
      try {
        this.scores = ((await api()) as { scores: Entry[] }).scores;
        this.render();
      } catch {
        if (this.status) this.status.textContent = this.texts.boardError ?? '';
      }
    },

    /** A signed start time, so the server can tell a played game from a typed-in score. */
    async start() {
      this.token = null;
      try {
        this.token = ((await api({ action: 'start' })) as { token: string }).token;
      } catch {
        /* no token: this game simply can't be submitted */
      }
    },

    /** Claim a name (or change it); throws with status 409 if another player has it. */
    async rename(name: string) {
      const result = (await api({ action: 'name', player: this.player, name })) as Result;
      this.setName(result.name);
      this.scores = result.scores;
      this.render();
    },

    /**
     * Send a finished game. Every game counts as a try, also with 0 points. Throws with status
     * 409 if the server doesn't know this player yet and the name is taken; the token stays
     * valid then, so the same game can be sent again under another name.
     */
    async submit(score: number, name?: string) {
      const { player, token } = this;
      name ??= this.name;
      const result = (await api({ action: 'submit', token, player, name, score })) as Result;
      this.token = null;
      this.setName(result.name);
      this.scores = result.scores;
      this.render();
      return result.rank;
    },
  };

  // ---------------------------------------------------------------------------
  // Sound: tiny synthesised effects (a metallic click, a freewheel tick, a thud)
  // ---------------------------------------------------------------------------
  const SOUND_KEY = 'snake-sound';
  const sound = {
    ctx: null as AudioContext | null,
    on: true,

    /** Create or wake the audio context; must first run inside a click or key press. */
    ready() {
      if (!this.on) return null;
      try {
        this.ctx ??= new AudioContext();
        if (this.ctx.state === 'suspended') void this.ctx.resume();
      } catch {
        return null;
      }
      return this.ctx;
    },

    tone(freq: number, dur: number, type: OscillatorType, volume: number, delay = 0) {
      const ctx = this.ready();
      if (!ctx) return;
      const t = ctx.currentTime + delay;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, t);
      gain.gain.setValueAtTime(volume, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(gain).connect(ctx.destination);
      osc.start(t);
      osc.stop(t + dur);
    },

    /** A gear clicking into place: two quick metallic blips. */
    eat() {
      this.tone(1480, 0.05, 'square', 0.05);
      this.tone(2220, 0.08, 'triangle', 0.07, 0.045);
    },

    /** A freewheel pawl ticking over. */
    turn() {
      this.tone(3600, 0.015, 'square', 0.012);
    },

    /** The chain hitting something: a filtered noise burst over a falling sine. */
    crash() {
      const ctx = this.ready();
      if (!ctx) return;
      const t = ctx.currentTime;
      const noise = ctx.createBufferSource();
      const buffer = ctx.createBuffer(1, Math.round(ctx.sampleRate * 0.3), ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < data.length; i++)
        data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
      noise.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 700;
      const noiseGain = ctx.createGain();
      noiseGain.gain.value = 0.18;
      noise.connect(filter).connect(noiseGain).connect(ctx.destination);
      noise.start(t);

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.frequency.setValueAtTime(150, t);
      osc.frequency.exponentialRampToValueAtTime(40, t + 0.35);
      gain.gain.setValueAtTime(0.25, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      osc.connect(gain).connect(ctx.destination);
      osc.start(t);
      osc.stop(t + 0.4);
    },
  };

  const root = document.getElementById('snake');
  const board = document.getElementById('snake-board');
  const canvas = document.getElementById('snake-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (root && board && canvas && ctx) {
    const $ = (id: string) => document.getElementById(id)!;
    const scoreEl = $('snake-score');
    const bestEl = $('snake-best');
    const overlay = $('snake-overlay');
    const message = $('snake-message');
    const action = $('snake-action') as HTMLButtonElement;
    const pauseBtn = $('snake-pause') as HTMLButtonElement;
    const text = JSON.parse(root.dataset.strings ?? '{}') as Record<string, string>;
    const entry = $('snake-entry') as HTMLFormElement;
    const nameInput = $('snake-name') as HTMLInputElement;
    const nameLabel = $('snake-name-label');
    const nameSave = entry.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const nameCancel = $('snake-name-cancel');
    const playerLine = $('snake-player');
    const playerName = $('snake-player-name');
    const syncPlayer = () => {
      playerLine.classList.toggle('hidden', !leaderboard.name);
      playerName.textContent = leaderboard.name;
    };
    const soundBtn = $('snake-sound') as HTMLButtonElement;
    const syncSound = () => {
      soundBtn.setAttribute('aria-pressed', String(sound.on));
      soundBtn.querySelector('.sound-on')?.classList.toggle('hidden', !sound.on);
      soundBtn.querySelector('.sound-off')?.classList.toggle('hidden', sound.on);
    };
    try {
      sound.on = localStorage.getItem(SOUND_KEY) !== 'off';
    } catch {
      /* storage unavailable: sound stays on */
    }
    syncSound();
    soundBtn.addEventListener('click', () => {
      sound.on = !sound.on;
      try {
        localStorage.setItem(SOUND_KEY, sound.on ? 'on' : 'off');
      } catch {
        /* ignore */
      }
      syncSound();
      if (sound.on) sound.eat();
    });
    leaderboard.texts = text;
    leaderboard.init();
    syncPlayer();
    leaderboard.load();

    let state: State = 'ready';
    let snake: Cell[] = [];
    /** The snake before the last step, so drawing can glide between cells. */
    let prev: Cell[] = [];
    let dir: Dir = 'right';
    let queue: Dir[] = [];
    let food: Cell = { x: 0, y: 0 };
    let score = 0;
    let interval = START_INTERVAL;
    let acc = 0;
    let last = 0;
    let best = 0;
    /** When the last game ended, so late key presses don't restart it at once. */
    let overAt = 0;
    try {
      best = Number(localStorage.getItem(BEST_KEY)) || 0;
    } catch {
      /* storage unavailable (private mode) — best score just isn't remembered */
    }
    bestEl.textContent = String(best);

    const placeFood = () => {
      const free: Cell[] = [];
      for (let y = 0; y < GRID; y++)
        for (let x = 0; x < GRID; x++)
          if (!snake.some((c) => c.x === x && c.y === y)) free.push({ x, y });
      if (free.length) food = free[Math.floor(Math.random() * free.length)]!;
      return free.length > 0;
    };

    const reset = () => {
      const mid = Math.floor(GRID / 2);
      snake = [
        { x: mid - 1, y: mid },
        { x: mid - 2, y: mid },
        { x: mid - 3, y: mid },
      ];
      prev = snake.map((c) => ({ ...c }));
      dir = 'right';
      queue = [];
      score = 0;
      interval = START_INTERVAL;
      acc = 0;
      scoreEl.textContent = '0';
      placeFood();
    };

    const setState = (next: State) => {
      state = next;
      overlay.style.display = next === 'running' ? 'none' : '';
      entry.classList.add('hidden');
      action.classList.remove('hidden');
      pauseBtn.disabled = next !== 'running' && next !== 'paused';
      if (next === 'paused') {
        message.textContent = text.paused ?? 'Paused';
        action.textContent = text.resume ?? 'Resume';
      } else if (next === 'over') {
        message.textContent = `${text.gameOver ?? 'Game over'} · ${text.score ?? 'Score'} ${score}`;
        action.textContent = text.again ?? 'Play again';
      } else if (next === 'ready') {
        message.textContent = 'Snake';
        action.textContent = text.start ?? 'Start';
      }
      if (next === 'running') last = performance.now();
    };

    /** What the name form is for: the first name, a change, or a name the server refused. */
    let nameMode: 'first' | 'change' | 'taken' = 'first';
    /** A finished game waiting for a free name before it can be sent. */
    let pending: number | null = null;
    const nameOpen = () => !entry.classList.contains('hidden');

    const openName = (mode: typeof nameMode) => {
      nameMode = mode;
      const label = { first: text.nameFirst, change: text.nameChange, taken: text.nameTaken };
      nameLabel.textContent = label[mode] ?? '';
      nameInput.value = leaderboard.name || (storage.get(OLD_NAME_KEY) ?? '');
      nameCancel.classList.toggle('hidden', mode !== 'change');
      action.classList.add('hidden');
      entry.classList.remove('hidden');
      nameInput.focus({ preventScroll: true });
      nameInput.select();
    };

    const closeName = () => {
      entry.classList.add('hidden');
      action.classList.remove('hidden');
      action.focus({ preventScroll: true });
    };

    const start = () => {
      if (state === 'paused') return setState('running');
      if (state === 'running') return;
      if (!leaderboard.name) return openName('first');
      reset();
      setState('running');
      sound.ready();
      void leaderboard.start();
      // On phones, bring score, board and buttons fully into view.
      if (matchMedia('(pointer: coarse)').matches) root.scrollIntoView({ block: 'start' });
    };

    const togglePause = () => {
      if (state === 'running') setState('paused');
      else if (state === 'paused') setState('running');
    };

    /**
     * Whether game input (arrows, swipes, space) may start a new round. After a
     * crash it waits a moment, and never while the name form is open, so a
     * late key press can't throw away the name being typed.
     */
    const canRestart = () =>
      !nameOpen() && (state !== 'over' || performance.now() - overAt > RESTART_DELAY);

    /** Queue a turn; ignores reversals and repeats so fast inputs never kill the snake. */
    const turn = (d: Dir) => {
      if (nameOpen()) return;
      if (state === 'ready' || state === 'over') {
        if (!canRestart()) return;
        start();
        if (d === OPPOSITE[dir]) return;
      } else if (state === 'paused') {
        setState('running');
      }
      const prev = queue.at(-1) ?? dir;
      if (d !== prev && d !== OPPOSITE[prev] && queue.length < 3) queue.push(d);
    };

    const gameOver = () => {
      overAt = performance.now();
      sound.crash();
      if (score > best) {
        best = score;
        bestEl.textContent = String(best);
        try {
          localStorage.setItem(BEST_KEY, String(best));
        } catch {
          /* ignore */
        }
      }
      setState('over');
      if (leaderboard.token) void send(score);
    };

    /** Send a finished game; on the board, the overlay then shows the player's place. */
    const send = async (points: number, name?: string) => {
      try {
        const rank = await leaderboard.submit(points, name);
        pending = null;
        syncPlayer();
        if (rank && state === 'over')
          message.textContent = `${text.gameOver ?? 'Game over'} · ${text.rank} ${rank}`;
      } catch (e) {
        if (state !== 'over') return;
        if (isTaken(e)) {
          pending = points;
          openName('taken');
        } else {
          message.textContent = text.saveError ?? '';
        }
      }
    };

    entry.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      if (!name) return;
      nameSave.disabled = true;
      if (nameMode === 'taken') {
        // Send the waiting game under the new name; that registers it.
        closeName();
        if (pending !== null) await send(pending, name);
      } else {
        try {
          await leaderboard.rename(name);
          syncPlayer();
          closeName();
        } catch (err) {
          if (isTaken(err) || nameMode === 'change') {
            nameLabel.textContent = (isTaken(err) ? text.nameTaken : text.nameError) ?? '';
            nameInput.select();
          } else {
            // Server unreachable: keep the name here; the first game sent registers it.
            leaderboard.setName(name);
            syncPlayer();
            closeName();
          }
        }
      }
      nameSave.disabled = false;
    });
    nameCancel.addEventListener('click', closeName);
    entry.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nameMode === 'change') closeName();
    });
    $('snake-rename').addEventListener('click', () => {
      if (state === 'running') setState('paused');
      openName('change');
    });

    const step = () => {
      const turned = queue.length > 0;
      dir = queue.shift() ?? dir;
      const head = snake[0]!;
      const next = { x: head.x + VEC[dir].x, y: head.y + VEC[dir].y };
      const eats = next.x === food.x && next.y === food.y;
      // The tail moves away this step unless the snake grows, so it is not an obstacle.
      const body = eats ? snake : snake.slice(0, -1);
      const hitWall = next.x < 0 || next.y < 0 || next.x >= GRID || next.y >= GRID;
      if (hitWall || body.some((c) => c.x === next.x && c.y === next.y)) return gameOver();
      if (turned) sound.turn();
      prev = snake.map((c) => ({ ...c }));
      snake.unshift(next);
      if (eats) {
        sound.eat();
        score++;
        scoreEl.textContent = String(score);
        interval = Math.max(MIN_INTERVAL, interval - 2);
        if (!placeFood()) gameOver(); // board full: you win
      } else {
        snake.pop();
      }
    };

    // Rendering — colours are read from the theme tokens so light/dark mode just works.
    let size = 0;
    const resize = () => {
      const dpr = window.devicePixelRatio || 1;
      size = board.clientWidth;
      canvas.width = Math.round(size * dpr);
      canvas.height = Math.round(size * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    new ResizeObserver(resize).observe(board);
    resize();

    /** A spur gear: `teeth` trapezoid teeth between root radius ri and tip radius ro, with a bore. */
    const drawGear = (
      cx: number,
      cy: number,
      ro: number,
      ri: number,
      teeth: number,
      angle: number,
    ) => {
      const pitch = (Math.PI * 2) / teeth;
      ctx.beginPath();
      for (let k = 0; k < teeth; k++) {
        const a = angle + k * pitch;
        const at = (r: number, da: number) =>
          ctx.lineTo(cx + r * Math.cos(a + da * pitch), cy + r * Math.sin(a + da * pitch));
        at(ri, -0.3);
        at(ro, -0.17);
        at(ro, 0.17);
        at(ri, 0.3);
        ctx.arc(cx, cy, ri, a + 0.3 * pitch, a + 0.7 * pitch);
      }
      ctx.closePath();
      ctx.moveTo(cx + ro * 0.3, cy);
      ctx.arc(cx, cy, ro * 0.3, 0, Math.PI * 2, true);
      ctx.fill('evenodd');
    };

    const draw = (now: number) => {
      const css = getComputedStyle(document.documentElement);
      const color = (name: string) => css.getPropertyValue(name).trim();
      const ink = color('--c-fg');
      const soft = color('--c-muted');
      const ground = color('--c-surface');
      const cell = size / GRID;
      ctx.clearRect(0, 0, size, size);

      // Grid paper: a dot at every crossing.
      ctx.fillStyle = color('--c-rule-strong');
      const dot = Math.max(1.5, cell * 0.07);
      for (let y = 1; y < GRID; y++)
        for (let x = 1; x < GRID; x++)
          ctx.fillRect(x * cell - dot / 2, y * cell - dot / 2, dot, dot);

      // Food: a gear, turning slowly.
      ctx.fillStyle = ink;
      drawGear(
        (food.x + 0.5) * cell,
        (food.y + 0.5) * cell,
        cell * 0.46,
        cell * 0.33,
        8,
        now / 900,
      );

      // Snake: a roller chain. Each link glides from its previous cell to its current one.
      const t = state === 'running' ? Math.min(acc / interval, 1) : 1;
      const pts = snake.map((c, i) => {
        const from = prev[i] ?? c;
        return {
          x: (from.x + (c.x - from.x) * t + 0.5) * cell,
          y: (from.y + (c.y - from.y) * t + 0.5) * cell,
        };
      });
      // Each link is a waisted plate between two pins: round ends, a narrower middle.
      // Inner plates (soft) are drawn first and the outer plates (ink) over them, as on a real chain.
      const plate = (
        a: { x: number; y: number },
        b: { x: number; y: number },
        end: number,
        waist: number,
      ) => {
        ctx.lineWidth = waist;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
        for (const p of [a, b]) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, end, 0, Math.PI * 2);
          ctx.fill();
        }
      };
      ctx.lineCap = 'butt';
      for (const parity of [1, 0]) {
        const outer = parity === 0;
        ctx.strokeStyle = ctx.fillStyle = outer ? ink : soft;
        for (let i = parity; i < pts.length - 1; i += 2)
          plate(pts[i]!, pts[i + 1]!, cell * (outer ? 0.34 : 0.29), cell * (outer ? 0.4 : 0.36));
      }
      // Pins at every joint; the head's pin is larger so the front of the chain reads.
      ctx.fillStyle = ground;
      pts.forEach((p, i) => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, cell * (i === 0 ? 0.16 : 0.1), 0, Math.PI * 2);
        ctx.fill();
      });
    };

    const loop = (now: number) => {
      if (state === 'running') {
        acc += Math.min(now - last, 250);
        last = now;
        while (acc >= interval && state === 'running') {
          acc -= interval;
          step();
        }
      }
      draw(now);
      requestAnimationFrame(loop);
    };

    // Keyboard
    window.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const target = e.target as HTMLElement;
      if (target.closest('input, textarea, select, dialog[open]')) return;
      const d = KEYS[e.key.length === 1 ? e.key.toLowerCase() : e.key];
      if (d) {
        e.preventDefault();
        turn(d);
      } else if (e.key === ' ' && target.tagName !== 'BUTTON') {
        e.preventDefault();
        if (state === 'running' || state === 'paused') togglePause();
        else if (canRestart()) start();
      }
    });

    // Swipes on the board (several turns per gesture are allowed)
    let origin: { x: number; y: number } | null = null;
    board.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      origin = { x: e.clientX, y: e.clientY };
    });
    board.addEventListener('pointermove', (e) => {
      if (!origin) return;
      const dx = e.clientX - origin.x;
      const dy = e.clientY - origin.y;
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 24) return;
      turn(Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : dy > 0 ? 'down' : 'up');
      origin = { x: e.clientX, y: e.clientY };
    });
    const endSwipe = () => (origin = null);
    board.addEventListener('pointerup', endSwipe);
    board.addEventListener('pointercancel', endSwipe);

    // On-screen buttons: react on press (not release) for snappy control
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
      const d = btn.dataset.dir as Dir;
      btn.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        turn(d);
      });
      btn.addEventListener('click', (e) => {
        if (e.detail === 0) turn(d); // keyboard activation
      });
    });

    action.addEventListener('click', start);
    pauseBtn.addEventListener('click', togglePause);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && state === 'running') setState('paused');
    });

    reset();
    setState('ready');
    requestAnimationFrame((now) => {
      last = now;
      loop(now);
    });
  }
</script>
