---
/**
 * Human-readable landing page for the RSS feed. Browsers show /rss.xml as raw XML,
 * so site links point here; feed readers still use /rss.xml directly.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getUpdates } from '@/lib/content';
import { site } from '@/data/site';
import { formatDate, langPaths, useTranslations, type Lang } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const feedUrl = new URL('/rss.xml', site.url).href;
const updates = await getUpdates();
const steps = [t('rss.step1'), t('rss.step2'), t('rss.step3')];
---

<BaseLayout lang={lang} title={t('rss.title')} description={t('rss.intro')}>
  <PageHeader title={t('rss.title')} intro={t('rss.intro')} />

  <div class="container-page space-y-24">
    <section class="grid gap-6 lg:grid-cols-12" data-reveal>
      <h2 class="heading lg:col-span-3">{t('rss.address')}</h2>
      <div class="flex flex-col gap-2 sm:flex-row lg:col-span-8 lg:col-start-4">
        <input
          id="feed-url"
          type="text"
          readonly
          value={feedUrl}
          class="min-h-14 min-w-0 flex-1 bg-surface px-4 py-3 text-lead text-fg"
          aria-label={t('rss.address')}
        />
        <button
          type="button"
          id="feed-copy"
          class="btn btn-primary min-h-14 justify-center px-8"
          data-copied={t('rss.copied')}
        >
          {t('rss.copy')}
        </button>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-12" data-reveal>
      <h2 class="heading lg:col-span-3">{t('rss.how')}</h2>
      <ol class="list-decimal space-y-4 pl-7 text-lead marker:font-semibold lg:col-span-8 lg:col-start-4">
        {steps.map((step) => (
          <li class="max-w-[48ch] pl-2">{step}</li>
        ))}
      </ol>
    </section>

    <section class="bg-surface p-6 sm:p-10 lg:ml-[calc(25%+0.5rem)]" data-reveal>
      {updates.length === 0 ? (
        <p class="max-w-[60ch]">{t('rss.empty')}</p>
      ) : (
        <p>
          {t('rss.count')}: <span class="font-semibold tabular-nums">{updates.length}</span>
          <span class="text-muted"> · {formatDate(updates[0]!.data.date, lang)}</span>
        </p>
      )}
      <a href="/rss.xml" class="link mt-6 inline-block" type="application/rss+xml">
        {t('rss.raw')}
      </a>
    </section>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('feed-url') as HTMLInputElement | null;
  const button = document.getElementById('feed-copy');
  if (input && button) {
    const label = button.textContent;
    input.addEventListener('focus', () => input.select());
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(input.value);
      } catch {
        // Clipboard API unavailable (e.g. insecure context): select the text for manual copying.
        input.select();
        return;
      }
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 2000);
    });
  }
</script>
