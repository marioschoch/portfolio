---
/** Contact: obfuscated e-mail, LinkedIn, GitHub. No form (no backend needed). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { site } from '@/data/site';
import { tx } from '@/data/cv';
import { langPaths, useTranslations, type Lang } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const rows = [
  { label: t('contact.linkedin'), href: site.links.linkedin, text: 'linkedin.com/in/mario-schoch' },
  { label: t('contact.github'), href: site.links.github, text: 'github.com/marioschoch' },
];
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.intro')}>
  <PageHeader title={t('contact.title')} intro={t('contact.intro')} />

  <!-- Each way to reach me is a full-width row, set large; rows alternate two tones. -->
  <dl class="contact-rows">
    <div class="contact-row" data-reveal>
      <dt class="label">{t('contact.email')}</dt>
      <dd>
        <ObfuscatedEmail class="contact-link" />
        <noscript>
          <p class="mt-2 text-body">{t('contact.emailFallback')}</p>
        </noscript>
      </dd>
    </div>
    {rows.map((r) => (
      <div class="contact-row" data-reveal>
        <dt class="label">{r.label}</dt>
        <dd>
          <a href={r.href} class="contact-link" rel="me noopener">
            {r.text}
          </a>
        </dd>
      </div>
    ))}
    <div class="contact-row" data-reveal>
      <dt class="label">{t('contact.location')}</dt>
      <dd>{tx(site.location, lang)}</dd>
    </div>
  </dl>
</BaseLayout>

<style>
  @reference '../../styles/global.css';
  /* Full-bleed bands whose text sits on the page's own margins. */
  .contact-row {
    --gutter: 1.25rem;
    padding: 3.5rem max(var(--gutter), calc((100vw - 96rem) / 2 + var(--gutter))) 1.5rem;
  }
  @media (min-width: 40rem) {
    .contact-row {
      --gutter: 2rem;
      padding-top: 5rem;
      padding-bottom: 2rem;
    }
  }
  @media (min-width: 48rem) {
    .contact-row {
      display: grid;
      grid-template-columns: calc(25% - 0.5rem) 1fr;
      column-gap: 2rem;
      align-items: baseline;
    }
  }
  .contact-row:nth-child(odd) {
    background: var(--c-surface);
  }
  .contact-row dd {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 0.5rem + 4.4vw, 4.5rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }
  .contact-link {
    @apply underline decoration-transparent decoration-2 underline-offset-[0.12em] transition-colors hover:decoration-current;
  }
</style>
