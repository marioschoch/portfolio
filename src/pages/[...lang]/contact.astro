---
/** Contact: obfuscated e-mail, LinkedIn, GitHub. No form (no backend needed). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { site } from '@/data/site';
import { tx } from '@/data/cv';
import { langPaths, useTranslations, type Lang } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const rows = [
  { label: t('contact.linkedin'), href: site.links.linkedin, text: 'linkedin.com/in/mario-schoch' },
  { label: t('contact.github'), href: site.links.github, text: 'github.com/marioschoch' },
];
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.intro')}>
  <PageHeader title={t('contact.title')} intro={t('contact.intro')} />

  <!-- Each way to reach me is a row: the label in columns 1–3, the value set large from column 4. -->
  <div class="container-page">
    <dl class="border-b border-rule">
      <div class="contact-row grid-page">
        <dt class="contact-label label">{t('contact.email')}</dt>
        <dd class="contact-value">
          <ObfuscatedEmail class="link-quiet" />
          <noscript>
            <p class="mt-2 text-body">{t('contact.emailFallback')}</p>
          </noscript>
        </dd>
      </div>
      {rows.map((r) => (
        <div class="contact-row grid-page">
          <dt class="contact-label label">{r.label}</dt>
          <dd class="contact-value">
            <a href={r.href} class="link-quiet" rel="me noopener">
              {r.text}
            </a>
          </dd>
        </div>
      ))}
      <div class="contact-row grid-page">
        <dt class="contact-label label">{t('contact.location')}</dt>
        <dd class="contact-value">{tx(site.location, lang)}</dd>
      </div>
    </dl>
  </div>
</BaseLayout>

<style>
  @reference '../../styles/global.css';
  .contact-row {
    @apply gap-y-2 border-t border-rule py-4 md:py-6;
  }
  .contact-label {
    @apply md:col-span-3 md:pt-2;
  }
  .contact-value {
    @apply font-medium md:col-span-9 md:col-start-4;
    font-size: clamp(1.5rem, 0.5rem + 3.6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
</style>
