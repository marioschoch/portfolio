---
/**
 * CV page, rendered from src/data/cv.ts. Prints cleanly on A4 (see @media print in global.css).
 * If public/cv/Mario-Schoch-CV.pdf exists at build time, "View" and "Download" buttons appear.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { cv, tx, type CvEntry } from '@/data/cv';
import { site } from '@/data/site';
import { getProjects } from '@/lib/content';
import { langPaths, localizePath, locales, useTranslations, type Lang, type UiKey } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Builds always run from the project root, so the public/ folder is resolved from there.
const hasPdf = existsSync(join(process.cwd(), 'public', site.cvPdf));

const allProjects = await getProjects(lang);
const projects = cv.projects.map((id) => {
  const project = allProjects.find((p) => p.id === id);
  // Fail the build on typos instead of silently dropping the project.
  if (!project) throw new Error(`src/data/cv.ts references unknown project "${id}"`);
  return project;
});

/** '2024-07' → 'Jul 2024' in the current language. */
const month = (ym: string) =>
  new Intl.DateTimeFormat(locales[lang], { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(`${ym}-01T00:00:00Z`),
  );
const range = (e: { start: string; end?: string | undefined }) =>
  `${month(e.start)} – ${e.end ? month(e.end) : t('spec.present')}`;

const sections: { key: UiKey; entries: CvEntry[] }[] = [
  { key: 'cv.education', entries: cv.education },
  { key: 'cv.experience', entries: cv.experience },
];
---

<BaseLayout lang={lang} title={t('cv.title')} description={tx(cv.headline, lang)}>
  <div class="container-page max-w-4xl! py-12 print:max-w-none print:p-0">
    <header class="flex flex-col gap-6 border-b border-rule-strong pb-8 sm:flex-row sm:items-end sm:justify-between print:pb-4">
      <div>
        <p class="label mb-3 print:hidden">{t('cv.title')}</p>
        <h1 class="text-3xl sm:text-4xl print:text-2xl">{site.name}</h1>
        <p class="mt-3 max-w-xl text-fg-soft">{tx(cv.headline, lang)}</p>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
          <li>{site.location}</li>
          <li><ObfuscatedEmail class="hover:text-fg" /></li>
          <li><a href={site.links.linkedin} class="hover:text-fg">linkedin.com/in/mario-schoch</a></li>
          <li><a href={site.links.github} class="hover:text-fg">github.com/marioschoch</a></li>
        </ul>
      </div>
      <div class="no-print flex flex-wrap gap-2">
        {
          hasPdf && (
            <>
              <a href={site.cvPdf} class="btn btn-primary" download>
                {t('cv.download')}
              </a>
              <a href={site.cvPdf} class="btn" target="_blank" rel="noopener">
                {t('cv.view')} ↗
              </a>
            </>
          )
        }
        <button type="button" class="btn" data-print>{t('cv.print')}</button>
      </div>
    </header>

    {
      sections.map(({ key, entries }) =>
        entries.length ? (
          <section class="cv-section">
            <h2 class="cv-heading">{t(key)}</h2>
            <ol class="space-y-6 print:space-y-3">
              {entries.map((e) => (
                <li class="cv-entry print-break-avoid">
                  <p class="cv-date">{range(e)}</p>
                  <div>
                    <h3 class="font-semibold text-fg">{tx(e.title, lang)}</h3>
                    <p class="text-sm text-fg-soft">
                      {tx(e.org, lang)}
                      {e.location && <span class="text-muted"> · {tx(e.location, lang)}</span>}
                    </p>
                    {e.details && (
                      <ul class="mt-2 space-y-1 text-sm text-fg-soft">
                        {e.details.map((d) => (
                          <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2 before:bg-muted">
                            {tx(d, lang)}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null,
      )
    }

    <section class="cv-section">
      <h2 class="cv-heading">{t('cv.projects')}</h2>
      <ol class="space-y-4 print:space-y-2">
        {
          projects.map((p) => (
            <li class="cv-entry print-break-avoid">
              <p class="cv-date">
                {p.entry.data.timeframe.start.getUTCFullYear()}
              </p>
              <div>
                <h3 class="font-semibold text-fg">
                  <a href={localizePath(`/projects/${p.id}/`, lang)} class="hover:text-accent">
                    {p.title}
                  </a>
                </h3>
                <p class="text-sm text-fg-soft">{p.summary}</p>
                <p class="mt-1 font-mono text-2xs text-muted">{p.entry.data.tools.join(' · ')}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      cv.volunteering.length > 0 && (
        <section class="cv-section">
          <h2 class="cv-heading">{t('cv.volunteering')}</h2>
          <ol class="space-y-6 print:space-y-3">
            {cv.volunteering.map((e) => (
              <li class="cv-entry print-break-avoid">
                <p class="cv-date">{range(e)}</p>
                <div>
                  <h3 class="font-semibold text-fg">{tx(e.title, lang)}</h3>
                  <p class="text-sm text-fg-soft">{tx(e.org, lang)}</p>
                  {e.details?.map((d) => (
                    <p class="mt-2 text-sm text-fg-soft">{tx(d, lang)}</p>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <div class="grid gap-x-10 sm:grid-cols-2 print:grid-cols-2">
      <section class="cv-section">
        <h2 class="cv-heading">{t('cv.skills')}</h2>
        <dl class="space-y-3 text-sm">
          {
            cv.skills.map((s) => (
              <div class="grid grid-cols-[7.5rem_1fr] gap-3">
                <dt class="font-mono text-xs text-muted">{tx(s.category, lang)}</dt>
                <dd class="text-fg-soft">{s.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section class="cv-section">
        <h2 class="cv-heading">{t('cv.languages')}</h2>
        <dl class="space-y-3 text-sm">
          {
            cv.languages.map((l) => (
              <div class="grid grid-cols-[7.5rem_1fr] gap-3">
                <dt class="font-mono text-xs text-muted">{tx(l.language, lang)}</dt>
                <dd class="text-fg-soft">{tx(l.level, lang)}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    {
      cv.awards.length > 0 && (
        <section class="cv-section">
          <h2 class="cv-heading">{t('cv.awards')}</h2>
          <ul class="space-y-2 text-sm">
            {cv.awards.map((a) => (
              <li class="cv-entry">
                <p class="cv-date">{month(a.date)}</p>
                <p class="text-fg-soft">
                  <span class="font-semibold text-fg">{tx(a.title, lang)}</span>
                  {a.org && <> · {tx(a.org, lang)}</>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  @reference '../../styles/global.css';
  .cv-section {
    @apply mt-10 print:mt-5;
  }
  .cv-heading {
    @apply mb-5 border-b border-rule pb-2 label text-fg print:mb-2;
  }
  .cv-entry {
    @apply grid gap-1 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6 print:grid-cols-[8rem_minmax(0,1fr)] print:gap-4;
  }
  .cv-date {
    @apply pt-0.5 font-mono text-xs text-muted;
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
