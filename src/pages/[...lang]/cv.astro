---
/**
 * CV page, rendered from src/data/cv.ts. Prints cleanly on A4 (see @media print in global.css).
 * If public/cv/Mario-Schoch-CV.pdf exists at build time, "View" and "Download" buttons appear.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { cv, tx, type CvEntry } from '@/data/cv';
import { site } from '@/data/site';
import { getProjects } from '@/lib/content';
import {
  langPaths,
  localizePath,
  locales,
  useTranslations,
  type Lang,
  type UiKey,
} from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Builds always run from the project root, so the public/ folder is resolved from there.
const hasPdf = existsSync(join(process.cwd(), 'public', site.cvPdf));

const allProjects = await getProjects(lang);
const projects = cv.projects.map((id) => {
  const project = allProjects.find((p) => p.id === id);
  // Fail the build on typos instead of silently dropping the project.
  if (!project) throw new Error(`src/data/cv.ts references unknown project "${id}"`);
  return project;
});

/** '2024-07' → 'Jul 2024' in the current language. */
const month = (ym: string) =>
  new Intl.DateTimeFormat(locales[lang], {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${ym}-01T00:00:00Z`));
const range = (e: { start: string; end?: string | undefined }) =>
  e.end === e.start
    ? month(e.start)
    : `${month(e.start)} – ${e.end ? month(e.end) : t('spec.present')}`;

const sections: { key: UiKey; entries: CvEntry[] }[] = [
  { key: 'cv.education', entries: cv.education },
  { key: 'cv.experience', entries: cv.experience },
];
---

<BaseLayout lang={lang} title={t('cv.title')} description={tx(cv.headline, lang)}>
  <div class="container-page pt-16 sm:pt-24 print:max-w-none print:p-0">
    <header class="grid gap-10 pb-8 lg:grid-cols-12 print:block print:pb-4" data-reveal>
      <div class="lg:col-span-9">
        <h1 class="display print:text-[26pt] print:tracking-tight">{site.name}</h1>
        <p class="mt-8 max-w-[40ch] text-lead print:mt-2 print:text-[11pt]">
          {tx(cv.headline, lang)}
        </p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 print:mt-2 print:text-[9pt]">
          <li>{tx(site.location, lang)}</li>
          <li>
            <ObfuscatedEmail class="link" />
          </li>
          <li>
            <a href={site.links.linkedin} class="link">
              linkedin.com/in/mario-schoch
            </a>
          </li>
          <li>
            <a href={site.links.github} class="link">
              github.com/marioschoch
            </a>
          </li>
        </ul>
      </div>
      <div class="no-print flex flex-wrap items-center gap-2 lg:col-span-3 lg:flex-col lg:items-end lg:justify-end">
        <p class="label mr-auto lg:mr-0 lg:mb-2">{t('cv.title')}</p>
        {hasPdf && (
          <>
            <a href={site.cvPdf} class="btn btn-primary" download>
              {t('cv.download')}
            </a>
            <a href={site.cvPdf} class="btn" target="_blank" rel="noopener">
              {t('cv.view')} ↗
            </a>
          </>
        )}
        <button type="button" class="btn" data-print>
          {t('cv.print')}
        </button>
      </div>
    </header>

    {sections.map(({ key, entries }) =>
      entries.length ? (
        <section class="cv-section">
          <h2 class="cv-heading">{t(key)}</h2>
          <ol class="cv-body space-y-10 print:space-y-3">
            {entries.map((e) => (
              <li class="cv-entry print-break-avoid" data-reveal>
                <p class="cv-date">{range(e)}</p>
                <div>
                  <h3 class="cv-title">{tx(e.title, lang)}</h3>
                  <p>
                    {tx(e.org, lang)}
                    {e.location && <span class="text-muted"> · {tx(e.location, lang)}</span>}
                  </p>
                  {e.details && (
                    <ul class="mt-3 list-disc space-y-1 pl-5 marker:text-muted print:mt-1">
                      {e.details.map((d) => (
                        <li>{tx(d, lang)}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ) : null,
    )}

    {projects.length > 0 && (
      <section class="cv-section">
        <h2 class="cv-heading">{t('cv.projects')}</h2>
        <ol class="cv-body space-y-8 print:space-y-2">
          {projects.map((p) => (
            <li class="cv-entry print-break-avoid" data-reveal>
              <p class="cv-date">{p.entry.data.timeframe.start.getUTCFullYear()}</p>
              <div>
                <h3 class="cv-title">
                  <a href={localizePath(`/projects/${p.id}/`, lang)} class="link">
                    {p.title}
                  </a>
                </h3>
                <p>{p.summary}</p>
                <p class="mt-1 label">{p.tools.join(' · ')}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {cv.volunteering.length > 0 && (
      <section class="cv-section">
        <h2 class="cv-heading">{t('cv.volunteering')}</h2>
        <ol class="cv-body space-y-10 print:space-y-3">
          {cv.volunteering.map((e) => (
            <li class="cv-entry print-break-avoid" data-reveal>
              <p class="cv-date">{range(e)}</p>
              <div>
                <h3 class="cv-title">{tx(e.title, lang)}</h3>
                <p>{tx(e.org, lang)}</p>
                {e.details?.map((d) => (
                  <p class="mt-3 max-w-[60ch] print:mt-1">{tx(d, lang)}</p>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="cv-section">
      <h2 class="cv-heading">{t('cv.skills')}</h2>
      <dl class="cv-body space-y-4 print:space-y-1" data-reveal>
        {cv.skills.map((s) => (
          <div class="cv-entry">
            <dt class="cv-date">{tx(s.category, lang)}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-section">
      <h2 class="cv-heading">{t('cv.languages')}</h2>
      <dl class="cv-body space-y-4 print:space-y-1" data-reveal>
        {cv.languages.map((l) => (
          <div class="cv-entry">
            <dt class="cv-date">{tx(l.language, lang)}</dt>
            <dd>{tx(l.level, lang)}</dd>
          </div>
        ))}
      </dl>
    </section>

    {cv.awards.length > 0 && (
      <section class="cv-section">
        <h2 class="cv-heading">{t('cv.awards')}</h2>
        <ul class="cv-body space-y-4 print:space-y-1" data-reveal>
          {cv.awards.map((a) => (
            <li class="cv-entry">
              <p class="cv-date">{month(a.date)}</p>
              <p>
                <span class="font-semibold">{tx(a.title, lang)}</span>
                {a.org && <> · {tx(a.org, lang)}</>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  @reference '../../styles/global.css';
  /* Each section: its heading on the left quarter, the entries on the right. */
  .cv-section {
    @apply mt-20 grid gap-6 sm:mt-28 lg:grid-cols-12 lg:gap-8 print:mt-4 print:block;
  }
  .cv-heading {
    @apply heading lg:col-span-3 print:mb-2 print:text-[12pt];
  }
  .cv-body {
    @apply lg:col-span-9;
  }
  .cv-entry {
    @apply grid gap-1 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8 print:grid-cols-[8rem_minmax(0,1fr)] print:gap-4;
  }
  .cv-date {
    @apply pt-0.5 text-small text-muted tabular-nums sm:pt-1;
  }
  .cv-title {
    @apply text-lead leading-snug font-semibold print:text-[10.5pt];
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
