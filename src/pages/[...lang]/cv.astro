---
/**
 * CV page, rendered from src/data/cv.ts. The downloadable PDF is a separate A4 layout of the same
 * data (cv/pdf.astro), printed to public/cv/ by `npm run cv:pdf`; the button appears once it exists.
 */
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import portrait from '@/assets/portrait.jpg';
import { cv, cefrStep, cvDate, cvRange, tx, type CvEntry } from '@/data/cv';
import { site } from '@/data/site';
import { getProjects } from '@/lib/content';
import { langPaths, localizePath, useTranslations, type Lang, type UiKey } from '@/i18n/utils';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Builds always run from the project root, so the public/ folder is resolved from there.
const pdfPath = join(process.cwd(), 'public', site.cvPdf[lang]);
const pdfSize = existsSync(pdfPath)
  ? `${Math.round(statSync(pdfPath).size / 1000).toLocaleString(lang)} kB`
  : null;

const allProjects = await getProjects(lang);
const findProject = (id: string) => {
  const project = allProjects.find((p) => p.id === id);
  // Fail the build on typos instead of silently dropping the project.
  if (!project) throw new Error(`src/data/cv.ts references unknown project "${id}"`);
  return project;
};
const projects = cv.projects.map(findProject);
const projectHref = (id: string) => localizePath(`/projects/${findProject(id).id}/`, lang);

const sections: { key: UiKey; entries: CvEntry[] }[] = [
  { key: 'cv.education', entries: cv.education },
  { key: 'cv.experience', entries: cv.experience },
];
---

<BaseLayout lang={lang} title={t('cv.title')} description={tx(cv.headline, lang)}>
  <div class="container-page pt-12 md:pt-16">
    <header class="grid-page gap-y-6">
      <!-- Name, headline, links and download are placed on the page grid one by one. -->
      <div class="contents">
        <p class="label md:col-span-3">{t('cv.title')}</p>
        <h1 class="display md:col-span-9 md:row-start-2">{site.name}</h1>
        <div class="mt-2 border-t border-rule md:row-start-3" aria-hidden="true"></div>
        <p class="max-w-[40ch] text-lead md:col-span-6 md:col-start-4 md:row-start-4">
          {tx(cv.headline, lang)}
        </p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 md:col-span-9 md:col-start-4 md:row-start-5">
          <li>{tx(site.location, lang)}</li>
          <li>
            <ObfuscatedEmail class="link" />
          </li>
          <li>
            <a href={site.links.linkedin} class="link">
              linkedin.com/in/mario-schoch
            </a>
          </li>
          <li>
            <a href={site.links.github} class="link">
              github.com/marioschoch
            </a>
          </li>
        </ul>
        {pdfSize && (
          <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 md:col-span-9 md:col-start-4 md:row-start-6">
            <a href={site.cvPdf[lang]} class="btn btn-primary" download>
              {t('cv.download')}
              <span aria-hidden="true">↓</span>
            </a>
            <span class="label">PDF · A4 · {pdfSize}</span>
          </p>
        )}
      </div>
      <div class="order-first col-span-2 md:order-none md:col-span-3 md:col-start-10 md:row-span-2 md:row-start-1">
        <Image
          src={portrait}
          alt={t('cv.portraitAlt')}
          widths={[240, 480, 720]}
          sizes="(min-width: 768px) 25vw, 50vw"
          class="aspect-[4/5] w-full object-cover object-[50%_20%]"
          loading="eager"
        />
      </div>
    </header>

    <section class="cv-section grid-page">
      <h2 class="cv-heading">{t('cv.about')}</h2>
      <p class="max-w-[46rem] text-lead md:col-span-7 md:col-start-4">{tx(cv.about, lang)}</p>
    </section>

    {sections.map(({ key, entries }) =>
      entries.length ? (
        <section class="cv-section grid-page">
          <h2 class="cv-heading">{t(key)}</h2>
          <ol class="cv-body">
            {entries.map((e) => (
              <li class="cv-entry">
                <p class="cv-date">{cvRange(e, lang)}</p>
                <div class="cv-content">
                  <h3 class="cv-title">{tx(e.title, lang)}</h3>
                  <p>
                    {e.url ? (
                      <a href={e.url} class="link" rel="noopener">
                        {tx(e.org, lang)} <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      tx(e.org, lang)
                    )}
                    {e.location && <span class="text-muted"> · {tx(e.location, lang)}</span>}
                  </p>
                  {e.details && (
                    <ul class="mt-2 list-disc space-y-2 pl-6">
                      {e.details.map((d) => (
                        <li>{tx(d, lang)}</li>
                      ))}
                    </ul>
                  )}
                  {e.thesis && (
                    <a
                      href={projectHref(e.thesis.project)}
                      class="group mt-4 flex max-w-[40rem] items-baseline justify-between gap-6 border-y border-rule py-2"
                    >
                      <span>
                        <span class="label block">{t('cv.thesis')}</span>
                        <span class="mt-1 block">
                          <span class="font-medium">«{e.thesis.title}»</span>,{' '}
                          {tx(e.thesis.note, lang)}
                        </span>
                      </span>
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ) : null,
    )}

    {projects.length > 0 && (
      <section class="cv-section grid-page">
        <h2 class="cv-heading">{t('cv.projects')}</h2>
        <ol class="cv-body">
          {projects.map((p) => (
            <li class="cv-entry">
              <p class="cv-date">{p.entry.data.timeframe.start.getUTCFullYear()}</p>
              <div class="cv-content">
                <h3 class="cv-title">
                  <a href={localizePath(`/projects/${p.id}/`, lang)} class="link">
                    {p.title}
                  </a>
                </h3>
                <p>{p.summary}</p>
                <p class="mt-1 label">{p.tools.join(' · ')}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {cv.volunteering.length > 0 && (
      <section class="cv-section grid-page">
        <h2 class="cv-heading">{t('cv.volunteering')}</h2>
        <ol class="cv-body">
          {cv.volunteering.map((e) => (
            <li class="cv-entry">
              <p class="cv-date">{cvRange(e, lang)}</p>
              <div class="cv-content">
                <h3 class="cv-title">{tx(e.title, lang)}</h3>
                <p>
                  {e.url ? (
                    <a href={e.url} class="link" rel="noopener">
                      {tx(e.org, lang)} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    tx(e.org, lang)
                  )}
                </p>
                {e.details?.map((d) => (
                  <p class="mt-2 max-w-[60ch]">{tx(d, lang)}</p>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="cv-section grid-page">
      <h2 class="cv-heading">{t('cv.skills')}</h2>
      <dl class="cv-body">
        {cv.skills.map((s) => (
          <div class="cv-entry">
            <dt class="cv-date">{tx(s.category, lang)}</dt>
            <dd class="cv-content">{s.items.map((item) => tx(item, lang)).join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-section grid-page">
      <h2 class="cv-heading">{t('cv.languages')}</h2>
      <dl class="cv-body">
        {cv.languages.map((l) => (
          <div class="cv-entry">
            <dt class="cv-date">{tx(l.language, lang)}</dt>
            <dd class="cv-content flex items-center gap-4">
              {/* The six CEFR steps, A1 to C2. */}
              <span class="flex gap-1" aria-hidden="true">
                {[1, 2, 3, 4, 5, 6].map((step) => (
                  <span
                    class:list={[
                      'h-2 w-6 border border-fg',
                      step <= cefrStep(l.level) ? 'bg-fg' : 'bg-transparent',
                    ]}
                  />
                ))}
              </span>
              {l.level === 'native' ? t('cv.native') : l.level}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    {cv.awards.length > 0 && (
      <section class="cv-section grid-page">
        <h2 class="cv-heading">{t('cv.awards')}</h2>
        <ul class="cv-body">
          {cv.awards.map((a) => (
            <li class="cv-entry">
              <p class="cv-date">{cvDate(a.date, lang)}</p>
              <p class="cv-content">
                <span class="font-medium">{tx(a.title, lang)}</span>
                {a.org && <> · {tx(a.org, lang)}</>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  @reference '../../styles/global.css';
  /* Each section: a hairline and its numbered heading, then a table on the page grid with the
     dates (or labels) in columns 1–3 and the entries from column 4. */
  .cv-section {
    @apply mt-16 gap-y-8 border-t border-rule pt-4 md:mt-24;
  }
  .cv-heading {
    @apply section-title;
  }
  .cv-body {
    @apply col-span-full grid grid-cols-subgrid content-start border-b border-rule;
  }
  .cv-entry {
    @apply col-span-full grid grid-cols-subgrid gap-y-1 border-t border-rule py-4;
  }
  .cv-date {
    @apply col-span-full text-small text-muted tabular-nums md:col-span-3 md:pt-1;
  }
  .cv-content {
    @apply col-span-full md:col-span-7 md:col-start-4;
  }
  .cv-title {
    @apply text-lead font-medium;
  }
</style>
