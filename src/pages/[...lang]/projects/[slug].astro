---
/**
 * Project detail page: spec sheet, key figures, write-up (problem → approach → result),
 * gallery, optional 3D model and the project log.
 * German pages use de.mdx when present, otherwise the English text with a notice.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecSheet from '@/components/SpecSheet.astro';
import KeyFigures from '@/components/KeyFigures.astro';
import Gallery from '@/components/Gallery.astro';
import ModelViewer from '@/components/ModelViewer.astro';
import Timeline from '@/components/Timeline.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { getCollection } from 'astro:content';
import { getProjectUpdates, localizeProject } from '@/lib/content';
import { site } from '@/data/site';
import { formatDate, isoDate, langs, localizePath, useTranslations, type Lang } from '@/i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.flatMap((entry) =>
    langs.map((lang) => ({
      params: { lang: lang === 'en' ? undefined : lang, slug: entry.id },
      props: { lang, entry },
    })),
  );
}

const { lang, entry } = Astro.props as {
  lang: Lang;
  entry: Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
};
const t = useTranslations(lang);
const project = await localizeProject(entry, lang);
const { data } = entry;
const { Content } = await render(project.translation ?? entry);
const updates = await getProjectUpdates(entry.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: new URL(localizePath(`/projects/${entry.id}/`, lang), site.url).href,
  dateCreated: isoDate(data.timeframe.start),
  dateModified: isoDate(project.lastUpdated),
  keywords: [...data.tags, ...data.tools].join(', '),
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<BaseLayout
  lang={lang}
  title={project.title}
  description={project.summary}
  image={`/og/projects/${entry.id}.png`}
  type="article"
  translated={project.translated}
  publishedTime={data.timeframe.start}
  modifiedTime={project.lastUpdated}
  jsonLd={jsonLd}
>
  <article>
    <header class="container-page pt-10 pb-16 sm:pt-14 sm:pb-24">
      <nav aria-label="Breadcrumb" class="mb-12">
        <a href={localizePath('/projects/', lang)} class="link">
          ← {t('project.back')}
        </a>
      </nav>
      <div data-reveal>
        <h1 class="max-w-[18ch] text-[clamp(2.5rem,1rem+5vw,6rem)] leading-[0.98] font-semibold tracking-[-0.045em]">
          {project.title}
        </h1>
        <div class="mt-10 md:ml-[50%]">
          <p class="max-w-[40ch] text-lead">{project.summary}</p>
          <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1 label">
            <span aria-label="Tags">{data.tags.map((tag) => `#${tag}`).join(' ')}</span>
            <span>
              {project.minutesRead} {t('project.readingTime')}
            </span>
            <span>
              {t('project.lastUpdated')}{' '}
              <time datetime={isoDate(project.lastUpdated)}>
                {formatDate(project.lastUpdated, lang)}
              </time>
            </span>
          </p>
        </div>
      </div>
    </header>

    <div class="container-page space-y-20 sm:space-y-28">
      <SpecSheet project={project} lang={lang} />

      {data.cover ? (
        <Image
          src={data.cover.src}
          alt={data.cover.alt}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1536px) 92rem, 100vw"
          class="w-full"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <ImagePlaceholder label={t('project.imagePending')} class="aspect-[21/9]!" />
      )}

      <KeyFigures figures={project.keyFigures} lang={lang} />

      <div class="grid gap-20 lg:grid-cols-12 lg:gap-8">
        <div class="prose min-w-0 lg:col-span-7 lg:col-start-4 [&>h2:first-child]:mt-0">
          <Content />
        </div>

        <aside
          class="lg:col-span-3 lg:col-start-1 lg:row-start-1 lg:pr-4"
          aria-labelledby="log-heading"
        >
          <h2 id="log-heading" class="mb-8 heading">
            {t('project.log')}
            <span class="sr-only">({updates.length})</span>
          </h2>
          {updates.length ? (
            <Timeline updates={updates} lang={lang} />
          ) : (
            <p class="text-muted">{t('project.logEmpty')}</p>
          )}
        </aside>
      </div>

      <Gallery images={data.gallery} lang={lang} />

      {data.model && <ModelViewer {...data.model} lang={lang} />}
    </div>
  </article>
</BaseLayout>
