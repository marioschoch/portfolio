---
/**
 * Project detail page: title, summary and spec sheet (in the label column), the showcase or
 * cover, key figures, write-up (problem → approach → result) beside the project log, gallery and
 * optional 3D model. Projects with an interactive showcase (a game,
 * a demo, a PDF reader) register it in `showcases` below; on the page it takes the place of the cover image,
 * which then only serves as the thumbnail on project cards.
 * German pages use de.mdx when present, otherwise the English text with a notice.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SpecSheet from '@/components/SpecSheet.astro';
import KeyFigures from '@/components/KeyFigures.astro';
import Gallery from '@/components/Gallery.astro';
import ModelViewer from '@/components/ModelViewer.astro';
import Timeline from '@/components/Timeline.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import Numtrip from '@/components/projects/numtrip/Numtrip.astro';
import Maturarbeit from '@/components/projects/maturarbeit/Maturarbeit.astro';
import Learnanatomy from '@/components/projects/learnanatomy/Learnanatomy.astro';
import DeliveryRobot from '@/components/projects/delivery-robot/DeliveryRobot.astro';
import { getCollection } from 'astro:content';
import { getProjectUpdates, localizeProject } from '@/lib/content';
import { site } from '@/data/site';
import {
  formatDate,
  isoDate,
  langs,
  localizePath,
  ogImagePath,
  useTranslations,
  type Lang,
} from '@/i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.flatMap((entry) =>
    langs.map((lang) => ({
      params: { lang: lang === 'en' ? undefined : lang, slug: entry.id },
      props: { lang, entry },
    })),
  );
}

const { lang, entry } = Astro.props as {
  lang: Lang;
  entry: Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
};
const t = useTranslations(lang);
const project = await localizeProject(entry, lang);
const { data } = entry;
const { Content } = await render(project.translation ?? entry);
const updates = await getProjectUpdates(entry.id);
/** Interactive sections per project slug, shown between the spec sheet and the write-up. */
const showcases: Record<string, typeof Numtrip> = {
  numtrip: Numtrip,
  maturarbeit: Maturarbeit,
  learnanatomy: Learnanatomy,
  'delivery-robot': DeliveryRobot,
};
const Showcase = showcases[entry.id];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: new URL(localizePath(`/projects/${entry.id}/`, lang), site.url).href,
  dateCreated: isoDate(data.timeframe.start),
  dateModified: isoDate(project.lastUpdated),
  keywords: [...data.tags.map((tag) => t(`tag.${tag}`)), ...project.tools].join(', '),
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<BaseLayout
  lang={lang}
  title={project.title}
  description={project.summary}
  image={ogImagePath(`projects/${entry.id}`, lang)}
  type="article"
  translated={project.translated}
  publishedTime={data.timeframe.start}
  modifiedTime={project.lastUpdated}
  jsonLd={jsonLd}
>
  <article>
    <header class="container-page pt-8 pb-16 md:pt-12 md:pb-24">
      <div class="grid-page gap-y-6">
        <nav aria-label={t('project.breadcrumb')} class="md:col-span-3">
          <a href={localizePath('/projects/', lang)} class="link-quiet text-small">
            ← {t('project.back')}
          </a>
        </nav>
        <h1
          class:list={[
            'md:col-span-11',
            project.title.length <= 16 ? 'display' : 'display-m max-w-[16ch]',
          ]}
        >
          {project.title}
        </h1>
        <div class="mt-2 border-t border-rule md:row-start-3" aria-hidden="true"></div>
        <p class="max-w-[36ch] text-lead md:col-span-6 md:col-start-4 md:row-span-2 md:row-start-4">
          {project.summary}
        </p>
        <p class="flex flex-col label md:col-span-3 md:col-start-1 md:row-start-4">
          <span aria-label={t('project.tags')}>
            {data.tags.map((tag) => `#${t(`tag.${tag}`)}`).join(' ')}
          </span>
          <span>
            {project.minutesRead} {t('project.readingTime')}
          </span>
          <span>
            {t('project.lastUpdated')}{' '}
            <time datetime={isoDate(project.lastUpdated)}>
              {formatDate(project.lastUpdated, lang)}
            </time>
          </span>
        </p>
        <SpecSheet
          project={project}
          lang={lang}
          class="md:col-span-3 md:col-start-1 md:row-start-5"
        />
      </div>
    </header>

    {Showcase ? (
      <div class="container-page space-y-16 md:space-y-24">
        <Showcase lang={lang} />
      </div>
    ) : project.cover ? (
      <div class="container-page grid-page">
        <Image
          src={project.cover.src}
          alt={project.cover.alt}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 768px) 75vw, 100vw"
          class="w-full md:col-span-9 md:col-start-4"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    ) : (
      <div class="container-page grid-page">
        <ImagePlaceholder label={t('project.imagePending')} class="md:col-span-9 md:col-start-4" />
      </div>
    )}

    <KeyFigures figures={project.keyFigures} lang={lang} />

    <div class="container-page mt-16 grid-page gap-y-12 md:mt-24">
      <div class="prose min-w-0 md:col-span-7 md:col-start-4 md:row-start-1 [&>h2:first-child]:mt-0">
        <Content />
      </div>

      <aside class="md:col-span-3 md:col-start-1 md:row-start-1" aria-labelledby="log-heading">
        <h2 id="log-heading" class="mb-6 section-title">
          {t('project.log')}
          <span class="sr-only">({updates.length})</span>
        </h2>
        {updates.length ? (
          <Timeline updates={updates} lang={lang} />
        ) : (
          <p class="text-muted">{t('project.logEmpty')}</p>
        )}
      </aside>
    </div>

    {(data.gallery.length > 0 || data.model) && (
      <div class="container-page mt-16 space-y-16 md:mt-24 md:space-y-24">
        <Gallery images={data.gallery} lang={lang} />
        {data.model && <ModelViewer models={[data.model]} lang={lang} />}
      </div>
    )}
  </article>
</BaseLayout>
