---
/**
 * About page. Texts live in this file per language (short enough to keep inline).
 * TODO: rewrite all texts in your own voice and add your photo (see README → Images).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import cyclingImage from '@/assets/home/hero-cycling.jpg';
import { personJsonLd } from '@/lib/person';
import { site } from '@/data/site';
import { langPaths, useTranslations, type Lang } from '@/i18n/utils';

// To add your photo: put it at src/assets/portrait.jpg, then uncomment these two lines
// and replace <ImagePlaceholder … /> below with:
//   <Image src={portrait} alt="Portrait of Mario Schoch" widths={[160, 320]} sizes="7rem" class="about-portrait object-cover" loading="eager" />
// import { Image } from 'astro:assets';
// import portrait from '@/assets/portrait.jpg';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const copy = {
  en: {
    /** Used as the meta description (no visible page header). */
    intro:
      'I study mechanical engineering at ETH Zürich and like problems where mechanics, electronics and software meet.',
    body: [
      // TODO: your own text
      'What draws me to engineering is the moment a design leaves the screen and has to work in the real world — when a mechanism that looked perfect in CAD meets friction, tolerances and noisy sensors. Most of my projects live at that boundary: robots, bicycle components and the software that ties them together.',
      'I enjoy the whole loop: modelling and analysing a part, building a prototype, measuring how it actually behaves and iterating. I document as I go, because a clear write-up is often what turns a working prototype into something a team can build on.',
    ],
    beyond: [
      // TODO
      'Cycling is my way to think — and the reason I can true a wheel faster than I can write a cover letter. As a board member of VELOVE Uni ZH, I help run free repair sessions where students learn to fix their own bikes.',
      'Outside of that I build small web projects, mostly for organisations I care about.',
    ],
  },
  de: {
    intro:
      'Ich studiere Maschinenbau an der ETH Zürich und mag Probleme, bei denen sich Mechanik, Elektronik und Software treffen.',
    body: [
      'Am Ingenieurwesen reizt mich der Moment, in dem ein Entwurf den Bildschirm verlässt und in der realen Welt funktionieren muss — wenn ein Mechanismus, der im CAD perfekt aussah, auf Reibung, Toleranzen und verrauschte Sensoren trifft. Die meisten meiner Projekte liegen genau an dieser Grenze: Roboter, Velokomponenten und die Software, die alles verbindet.',
      'Ich mag den ganzen Kreislauf: Bauteil modellieren und analysieren, Prototyp bauen, messen, wie er sich tatsächlich verhält, und iterieren. Ich dokumentiere laufend, weil eine klare Dokumentation oft das ist, was aus einem funktionierenden Prototyp etwas macht, worauf ein Team aufbauen kann.',
    ],
    beyond: [
      'Velofahren ist meine Art nachzudenken — und der Grund, warum ich ein Laufrad schneller zentriere, als ich ein Motivationsschreiben verfasse. Als Vorstandsmitglied von VELOVE Uni ZH organisiere ich kostenlose Reparaturtage, an denen Studierende lernen, ihre Velos selbst zu flicken.',
      'Daneben baue ich kleine Webprojekte, meist für Organisationen, die mir wichtig sind.',
    ],
  },
}[lang];
---

<BaseLayout lang={lang} title={t('about.title')} description={copy.intro} jsonLd={personJsonLd}>
  <h1 class="sr-only">{t('about.title')}</h1>

  <div class="container-page grid gap-12 pt-16 sm:pt-24 lg:grid-cols-12 lg:gap-8">
    <dl
      class="order-last grid grid-cols-3 gap-4 text-small lg:order-none lg:col-span-3 lg:block lg:space-y-5"
      data-reveal
    >
      <div>
        <dt class="text-muted">{t('contact.location')}</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt class="text-muted">ETH</dt>
        <dd>D-MAVT · BSc</dd>
      </div>
      <div>
        <dt class="text-muted">VELOVE</dt>
        <dd>{lang === 'de' ? 'Vorstand' : 'Board'}</dd>
      </div>
    </dl>

    <div class="about-text lg:col-span-8 lg:col-start-4" data-reveal>
      {copy.body.map((p, i) => (
        <p>
          {i === 0 && (
            <ImagePlaceholder label="Portrait" class="about-portrait aspect-auto! p-2!" />
          )}
          {p}
        </p>
      ))}
    </div>
  </div>

  <figure class="container-page mt-24 sm:mt-32" data-reveal>
    <div class="overflow-hidden">
      <Picture
        src={cyclingImage}
        alt={
          lang === 'de'
            ? 'Gruppe von Rennvelofahrern in voller Fahrt'
            : 'A group of road cyclists riding at speed'
        }
        widths={[640, 1024, 1600, 2400]}
        sizes="(min-width: 1536px) 92rem, 100vw"
        formats={['avif', 'webp']}
        class="about-photo aspect-[21/9] w-full object-cover"
      />
    </div>
    <figcaption class="mt-3 label">{t('home.photoCredit')} Lars Meier</figcaption>
  </figure>

  <section
    class="container-page mt-24 grid gap-8 sm:mt-32 lg:grid-cols-12"
    aria-labelledby="beyond-heading"
  >
    <h2 id="beyond-heading" class="heading lg:col-span-3" data-reveal>
      {t('about.beyond')}
    </h2>
    <div class="about-text lg:col-span-8 lg:col-start-4" data-reveal>
      {copy.beyond.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  @reference '../../styles/global.css';
  .about-text {
    @apply max-w-[46rem] space-y-[1.2em] text-lead leading-[1.45];
  }
  /* Portrait as a drop capital: three lines tall, the text wraps beside it. */
  .about-text :global(.about-portrait) {
    float: left;
    width: 4.3em;
    height: 4.3em;
    margin: 0.3em 0.6em 0 0;
  }
  .about-photo {
    @apply transition-transform duration-[1.6s] ease-out-strong hover:scale-[1.02];
  }
</style>
