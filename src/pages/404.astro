---
/**
 * Custom 404. Apache serves dist/404.html for unknown paths with a real 404 status
 * (`ErrorDocument 404 /404.html` in public/.htaccess). Shown in English with a German line.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/utils';

const t = useTranslations('en');
const de = useTranslations('de');
---

<BaseLayout lang="en" title={t('notFound.title')} description={t('notFound.text')} noindex>
  <section class="container-page pt-12 md:pt-16">
    <h1 class="display">{t('notFound.title')}</h1>
    <div class="mt-8 grid-page gap-y-4 border-t border-rule pt-4 md:mt-12">
      <p class="max-w-[36ch] text-lead md:col-span-6 md:col-start-4 md:row-start-1">
        {t('notFound.text')}
      </p>
      <p class="max-w-[44ch] md:col-span-6 md:col-start-4 md:row-start-2" lang="de-CH">
        {de('notFound.text')}
      </p>
      <p class="label md:col-span-3 md:col-start-1 md:row-start-1 md:pt-1">Error 404</p>
      <div class="mt-4 flex flex-wrap gap-2 md:col-span-9 md:col-start-4 md:row-start-3">
        <a href="/" class="btn btn-primary">
          {t('notFound.back')}
        </a>
        <a href="/de/" class="btn" lang="de-CH">
          {de('notFound.back')}
        </a>
        <button type="button" class="btn" data-palette-open>
          ⌘K · {t('palette.open')}
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
