---
/**
 * Custom 404. Apache serves dist/404.html for unknown paths with a real 404 status
 * (`ErrorDocument 404 /404.html` in public/.htaccess). Shown in English with a German line.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/utils';

const t = useTranslations('en');
const de = useTranslations('de');
---

<BaseLayout lang="en" title={t('notFound.title')} description={t('notFound.text')} noindex>
  <section class="container-page pt-16 sm:pt-24" data-reveal>
    <h1 class="display">{t('notFound.title')}</h1>
    <div class="mt-10 md:ml-[50%]" data-reveal>
      <p class="max-w-[36ch] text-lead">{t('notFound.text')}</p>
      <p class="mt-2 max-w-[44ch]" lang="de-CH">
        {de('notFound.text')}
      </p>
      <p class="mt-2 label">Error 404</p>
      <div class="mt-10 flex flex-wrap gap-2">
        <a href="/" class="btn btn-primary">
          {t('notFound.back')}
        </a>
        <a href="/de/" class="btn" lang="de-CH">
          {de('notFound.back')}
        </a>
        <button type="button" class="btn" data-palette-open>
          ⌘K · {t('palette.open')}
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
