---
/** Strip of highlighted key numbers (from the project frontmatter). */
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  figures: { value: string; unit?: string | undefined; label: string }[];
  lang: Lang;
}
const { figures, lang } = Astro.props;
const t = useTranslations(lang);
// Full static class names so Tailwind can detect them; avoids empty cells for 1–3 figures.
const cols = ['', 'lg:grid-cols-1', 'lg:grid-cols-2', 'lg:grid-cols-3', 'lg:grid-cols-4'][
  figures.length
];
---

{figures.length > 0 && (
  <section aria-label={t('project.keyFigures')}>
    <dl
      class:list={[
        'grid gap-px border border-rule bg-rule',
        figures.length > 1 && 'grid-cols-2',
        cols,
      ]}
    >
      {figures.map((f) => (
        <div class="flex flex-col-reverse justify-end gap-2 bg-bg p-4 odd:last:col-span-2 lg:odd:last:col-span-1">
          <dt class="text-xs leading-snug text-muted">{f.label}</dt>
          <dd class="font-mono text-2xl font-medium tracking-tight text-accent sm:text-3xl">
            {f.value}
            {f.unit && <span class="ml-1 text-base text-fg-soft">{f.unit}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}
