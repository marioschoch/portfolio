---
/**
 * Key numbers of a project (from the frontmatter): the page's one inverted section, the values set
 * large in tabular figures on the grid, one figure per three columns.
 */
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  figures: { value: string; unit?: string | undefined; label: string }[];
  lang: Lang;
}
const { figures, lang } = Astro.props;
const t = useTranslations(lang);
---

{figures.length > 0 && (
  <section aria-label={t('project.keyFigures')} class="mt-16 bg-fg text-bg md:mt-24">
    <dl class="container-page grid-page gap-y-8 py-12 md:py-16">
      {figures.map((f) => (
        <div class="col-span-2 flex flex-col-reverse justify-end gap-2 border-t border-bg pt-2 md:col-span-3">
          <dt class="max-w-[24ch] text-small text-invert-muted">{f.label}</dt>
          <dd class="display-m tabular-nums">
            {f.value}
            {f.unit && <span class="ml-1 text-lead font-normal tracking-normal">{f.unit}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}
