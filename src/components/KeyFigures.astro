---
/** Strip of highlighted key numbers (from the project frontmatter), on a red field. */
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  figures: { value: string; unit?: string | undefined; label: string }[];
  lang: Lang;
}
const { figures, lang } = Astro.props;
const t = useTranslations(lang);
// Full static class names so Tailwind can detect them; avoids empty cells for 1–3 figures.
const cols = ['', 'lg:grid-cols-1', 'lg:grid-cols-2', 'lg:grid-cols-3', 'lg:grid-cols-4'][
  figures.length
];
---

{figures.length > 0 && (
  <section aria-label={t('project.keyFigures')} class="bg-field text-field-ink">
    <dl
      class:list={['grid gap-x-8 gap-y-10 p-6 sm:p-10', figures.length > 1 && 'grid-cols-2', cols]}
      data-reveal
    >
      {figures.map((f) => (
        <div class="flex flex-col-reverse justify-end gap-3">
          <dt class="text-small leading-snug text-field-muted">{f.label}</dt>
          <dd class="heading tabular-nums">
            {f.value}
            {f.unit && <span class="ml-1 text-lead font-normal">{f.unit}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}
