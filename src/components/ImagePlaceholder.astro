---
/**
 * Placeholder for projects (and the portrait) without photos yet: a flat field one tone
 * darker than the page, with what belongs there written in its corner.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  label: string;
  /** Figure reference, e.g. "Fig. 01". */
  figure?: string;
  class?: string;
}
const { label, figure, class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    'relative flex aspect-[16/10] items-end justify-between gap-2 bg-surface p-4',
    className,
  ]}
  role="img"
  aria-label={label}
  {...rest}
>
  <span class="label" aria-hidden="true">
    {label}
  </span>
  {figure && (
    <span class="label" aria-hidden="true">
      {figure}
    </span>
  )}
</div>
