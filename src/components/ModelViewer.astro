---
/**
 * Interactive 3D viewer for CAD exports (GLB) using Google's <model-viewer>.
 * The ~300 kB viewer library and the model are only loaded after the visitor clicks
 * "Load", so the page stays fast and Lighthouse scores are unaffected.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  src: string;
  alt: string;
  poster?: ImageMetadata | undefined;
  lang: Lang;
}
const { src, alt, poster, lang } = Astro.props;
const t = useTranslations(lang);
const posterSrc = poster ? (await getImage({ src: poster, width: 1200, format: 'webp' })).src : '';
---

<section aria-labelledby="model-heading" data-model-viewer data-src={src} data-alt={alt} data-poster={posterSrc}>
  <h2 id="model-heading" class="label mb-4">{t('project.model')}</h2>
  <div class="relative aspect-[16/10] overflow-hidden border border-rule bg-surface" data-stage>
    <div class="bg-grid absolute inset-0 [mask-image:none]" aria-hidden="true"></div>
    {posterSrc && <img src={posterSrc} alt="" class="absolute inset-0 size-full object-contain" />}
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-4 text-center">
      <button type="button" class="btn btn-primary" data-load>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1.5 14 5v6l-6 3.5L2 11V5l6-3.5Zm0 0V8m0 0 6-3M8 8 2 5m6 3v6.5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
        </svg>
        {t('project.modelLoad')}
      </button>
      <p class="font-mono text-2xs text-muted">GLB · {alt}</p>
    </div>
  </div>
  <p class="mt-2 font-mono text-2xs text-muted">{t('project.modelHint')}</p>
</section>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-model-viewer]')) {
    const button = section.querySelector<HTMLButtonElement>('[data-load]');
    const stage = section.querySelector<HTMLElement>('[data-stage]');
    button?.addEventListener('click', async () => {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      await import('@google/model-viewer');
      const viewer = document.createElement('model-viewer');
      viewer.setAttribute('src', section.dataset.src ?? '');
      viewer.setAttribute('alt', section.dataset.alt ?? '');
      if (section.dataset.poster) viewer.setAttribute('poster', section.dataset.poster);
      viewer.setAttribute('camera-controls', '');
      viewer.setAttribute('touch-action', 'pan-y');
      viewer.setAttribute('shadow-intensity', '0.6');
      viewer.setAttribute('exposure', '1');
      viewer.setAttribute('camera-orbit', '35deg 65deg auto');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        viewer.setAttribute('auto-rotate', '');
        viewer.setAttribute('auto-rotate-delay', '1500');
      }
      viewer.style.width = '100%';
      viewer.style.height = '100%';
      viewer.style.setProperty('--poster-color', 'transparent');
      stage?.replaceChildren(viewer);
    });
  }
</script>
