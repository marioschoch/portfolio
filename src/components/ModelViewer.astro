---
/**
 * Interactive 3D viewer for CAD exports (GLB) using Google's <model-viewer>: one model, or the
 * parts of a project, listed in the label column to switch between them.
 * The ~300 kB viewer library and the model are only loaded after the visitor clicks
 * "Load", so the page stays fast and Lighthouse scores are unaffected.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '@/i18n/utils';

export interface Model {
  src: string;
  alt: string;
  /** Name in the list of parts (only shown when there are several models). */
  label?: string;
  /** One line under the stage, e.g. what the part does and its size. */
  note?: string;
  poster?: ImageMetadata | undefined;
}

interface Props {
  models: Model[];
  lang: Lang;
}
const { models, lang } = Astro.props;
const t = useTranslations(lang);
const parts = await Promise.all(
  models.map(async (model) => ({
    src: model.src,
    alt: model.alt,
    label: model.label ?? model.alt,
    note: model.note ?? '',
    poster: model.poster
      ? (await getImage({ src: model.poster, width: 1200, format: 'webp' })).src
      : '',
  })),
);
const first = parts[0]!;
const tabs = parts.length > 1;
---

<section
  aria-labelledby="model-heading"
  class="grid-page gap-y-6 border-t border-rule pt-4 lg:gap-y-0"
  data-model-viewer
  data-models={JSON.stringify(parts)}
>
  <div class="lg:col-span-3">
    <h2 id="model-heading" class="section-title">
      {t('project.model')}
    </h2>
    {tabs && (
      <div
        class="mt-6 flex flex-col border-t border-rule"
        role="tablist"
        aria-label={t('project.modelParts')}
        aria-orientation="vertical"
        data-tabs
      >
        {parts.map((part, i) => (
          <button
            type="button"
            role="tab"
            id={`model-tab-${i}`}
            aria-controls="model-panel"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="part flex min-h-11 touch-manipulation items-center gap-4 border-b border-rule py-2 text-left"
          >
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {part.label}
          </button>
        ))}
      </div>
    )}
  </div>

  <div
    id="model-panel"
    class="min-w-0 lg:col-span-9 lg:col-start-4 lg:row-start-1"
    role={tabs ? 'tabpanel' : undefined}
    aria-labelledby={tabs ? 'model-tab-0' : undefined}
  >
    <div class="relative aspect-[16/10] overflow-hidden bg-surface" data-stage>
      <img
        src={first.poster || undefined}
        alt=""
        class="absolute inset-0 size-full object-contain"
        hidden={!first.poster}
        data-poster
      />
      <div class="absolute inset-0 flex flex-col items-start justify-end gap-2 p-4" data-gate>
        <button type="button" class="btn btn-primary" data-load>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M8 1.5 14 5v6l-6 3.5L2 11V5l6-3.5Zm0 0V8m0 0 6-3M8 8 2 5m6 3v6.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"
            ></path>
          </svg>
          {t('project.modelLoad')}
        </button>
        <p class="label" data-alt>
          GLB · {first.alt}
        </p>
      </div>
    </div>
    <p class="mt-2 max-w-[60ch] label" hidden={!first.note} data-note>
      {first.note}
    </p>
    <p class="mt-2 label">{t('project.modelHint')}</p>
  </div>
</section>

<style>
  @reference '../styles/global.css';

  /* The open part in ink and medium weight, the others muted. */
  .part {
    @apply text-muted transition-colors duration-150 hover:text-fg;
  }
  .part[aria-selected='true'] {
    @apply font-medium text-fg;
  }
</style>

<script>
  type Part = { src: string; alt: string; note: string; poster: string };

  for (const section of document.querySelectorAll<HTMLElement>('[data-model-viewer]')) {
    const parts = JSON.parse(section.dataset.models ?? '[]') as Part[];
    const button = section.querySelector<HTMLButtonElement>('[data-load]');
    const stage = section.querySelector<HTMLElement>('[data-stage]');
    const poster = section.querySelector<HTMLImageElement>('[data-poster]');
    const alt = section.querySelector<HTMLElement>('[data-alt]');
    const note = section.querySelector<HTMLElement>('[data-note]');
    const panel = section.querySelector<HTMLElement>('[role="tabpanel"]');
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let current = 0;
    let viewer: HTMLElement | undefined;

    const show = (index: number, focus = false) => {
      current = index;
      const part = parts[index]!;
      for (const [i, tab] of tabs.entries()) {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      }
      if (focus) tabs[index]?.focus();
      panel?.setAttribute('aria-labelledby', tabs[index]?.id ?? '');
      if (note) {
        note.textContent = part.note;
        note.hidden = !part.note;
      }
      if (alt) alt.textContent = `GLB · ${part.alt}`;
      if (poster) {
        poster.hidden = !part.poster;
        if (part.poster) poster.src = part.poster;
      }
      if (viewer) {
        viewer.setAttribute('src', part.src);
        viewer.setAttribute('alt', part.alt);
        if (part.poster) viewer.setAttribute('poster', part.poster);
        else viewer.removeAttribute('poster');
      }
    };

    for (const [i, tab] of tabs.entries()) tab.addEventListener('click', () => show(i));
    section.querySelector('[data-tabs]')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[key];
      if (!step) return;
      e.preventDefault();
      show((current + step + tabs.length) % tabs.length, true);
    });

    button?.addEventListener('click', async () => {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      await import('@google/model-viewer');
      viewer = document.createElement('model-viewer');
      viewer.setAttribute('camera-controls', '');
      viewer.setAttribute('touch-action', 'pan-y');
      viewer.setAttribute('shadow-intensity', '0.6');
      viewer.setAttribute('exposure', '1');
      viewer.setAttribute('camera-orbit', '35deg 65deg auto');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        viewer.setAttribute('auto-rotate', '');
        viewer.setAttribute('auto-rotate-delay', '1500');
      }
      viewer.style.width = '100%';
      viewer.style.height = '100%';
      viewer.style.setProperty('--poster-color', 'transparent');
      viewer.style.setProperty('--progress-bar-color', 'var(--c-fg)');
      viewer.style.setProperty('--progress-bar-height', '1px');
      show(current);
      stage?.replaceChildren(viewer);
    });
  }
</script>
