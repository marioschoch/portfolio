---
/**
 * Spam-resistant e-mail link. The address is stored reversed and base64-encoded in a
 * data attribute and only assembled in the browser, so simple scrapers never see it.
 * Until then (or without JavaScript) the link points to the contact page instead of nowhere.
 */
import { site } from '@/data/site';
import { langFromPath, localizePath } from '@/i18n/utils';

interface Props {
  /** Visible text; when omitted the address itself is shown once decoded. */
  label?: string;
  class?: string;
  fallback?: string;
}
const { label, class: className, fallback } = Astro.props;
const encoded = Buffer.from(
  `${site.email.user}@${site.email.domain}`.split('').reverse().join(''),
).toString('base64');
const contactHref = localizePath('/contact/', langFromPath(Astro.url.pathname));
---

<a href={contactHref} data-email={encoded} data-label={label ?? ''} class:list={[className]}>
  {label ?? fallback ?? '…'}
</a>

<script>
  const decode = (el: HTMLAnchorElement) =>
    atob(el.dataset.email ?? '')
      .split('')
      .reverse()
      .join('');

  for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-email]')) {
    const address = decode(el);
    el.href = `mailto:${address}`;
    if (!el.dataset.label) el.textContent = address;
  }

  // Safety net: a click or Enter on a link that somehow kept its fallback href still opens mail.
  document.addEventListener('click', (event) => {
    const el = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-email]');
    if (!el || el.href.startsWith('mailto:')) return;
    event.preventDefault();
    window.location.href = `mailto:${decode(el)}`;
  });
</script>
