---
/** "In progress" / "Completed": in progress is marked with a filled dot in the ink. */
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  status: 'in-progress' | 'completed';
  lang: Lang;
}
const { status, lang } = Astro.props;
const t = useTranslations(lang);
---

<span class="inline-flex items-center gap-2 text-small text-muted">
  {status === 'in-progress' && <span class="size-2 rounded-full bg-fg" aria-hidden="true" />}
  {t(`status.${status}`)}
</span>
