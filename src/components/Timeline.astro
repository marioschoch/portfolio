---
/** Chronological log of one project's updates, shown on its project page. */
import { render } from 'astro:content';
import type { UpdateEntry } from '@/lib/content';
import { formatDate, isoDate, type Lang } from '@/i18n/utils';

interface Props {
  updates: UpdateEntry[];
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}
const { updates, lang, headingLevel: Heading = 'h3' } = Astro.props;
const rendered = await Promise.all(
  updates.map(async (u) => ({ u, Content: (await render(u)).Content })),
);
---

<ol class="space-y-16">
  {rendered.map(({ u, Content }) => (
    <li id={u.id} data-reveal>
      <p class="label">
        <time datetime={isoDate(u.data.date)}>{formatDate(u.data.date, lang)}</time>
      </p>
      <Heading class="mt-2 text-lead leading-snug">
        <a
          href={`#${u.id}`}
          class="underline decoration-transparent decoration-1 underline-offset-4 transition-colors hover:decoration-current"
        >
          {u.data.title}
        </a>
      </Heading>
      <div class="prose mt-3">
        <Content />
      </div>
    </li>
  ))}
</ol>
