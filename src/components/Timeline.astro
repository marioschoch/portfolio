---
/**
 * Chronological log of updates. Used on project pages (one project) and on the global
 * updates feed (all projects, with a link to the project of each entry).
 */
import { render } from 'astro:content';
import type { UpdateEntry } from '@/lib/content';
import { formatDate, isoDate, localizePath, type Lang } from '@/i18n/utils';

interface Props {
  updates: UpdateEntry[];
  lang: Lang;
  /** Map project id → title; when given, each entry links to its project. */
  projectTitles?: Record<string, string>;
  headingLevel?: 'h2' | 'h3';
}
const { updates, lang, projectTitles, headingLevel: Heading = 'h3' } = Astro.props;
const rendered = await Promise.all(
  updates.map(async (u) => ({ u, Content: (await render(u)).Content })),
);
---

<ol class="space-y-16">
  {rendered.map(({ u, Content }) => (
    <li id={u.id} data-reveal>
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 label">
        <time datetime={isoDate(u.data.date)}>{formatDate(u.data.date, lang)}</time>
        {projectTitles && (
          <a
            href={localizePath(`/projects/${u.data.project.id}/`, lang)}
            class="text-fg underline decoration-transparent underline-offset-4 transition-colors hover:decoration-current"
          >
            {projectTitles[u.data.project.id]}
          </a>
        )}
      </p>
      <Heading class="mt-2 text-lead leading-snug">
        <a
          href={`#${u.id}`}
          class="underline decoration-transparent decoration-1 underline-offset-4 transition-colors hover:decoration-current"
        >
          {u.data.title}
        </a>
      </Heading>
      <div class="prose mt-3">
        <Content />
      </div>
    </li>
  ))}
</ol>
