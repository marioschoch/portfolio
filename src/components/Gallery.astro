---
/**
 * Image gallery with a lightweight lightbox built on <dialog>.
 * Thumbnails and the full-size images go through Astro's image pipeline (AVIF/WebP, srcset).
 * Keyboard: ←/→ to navigate, Esc to close. Touch: swipe left/right.
 */
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string | undefined }[];
  lang: Lang;
}
const { images, lang } = Astro.props;
const t = useTranslations(lang);

// Pre-compute the large version shown in the lightbox.
const full = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1800, format: 'webp', quality: 82 })),
);
---

{images.length > 0 && (
  <section aria-labelledby="gallery-heading" data-gallery>
    <h2 id="gallery-heading" class="label mb-4">
      {t('project.gallery')}
    </h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {images.map((img, i) => (
        <li>
          <figure>
            <button
              type="button"
              class="block w-full cursor-zoom-in overflow-hidden border border-rule"
              data-index={i}
              data-full={full[i]?.src}
              data-caption={img.caption ?? ''}
              aria-label={`${img.alt} — ${t('project.figure')} ${String(i + 1).padStart(2, '0')}`}
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[320, 480, 720]}
                sizes="(min-width: 640px) 30vw, 50vw"
                class="aspect-[4/3] w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
              />
            </button>
            <figcaption class="mt-1.5 font-mono text-2xs text-muted">
              {t('project.figure')} {String(i + 1).padStart(2, '0')}
              {img.caption && <span class="text-fg-soft"> — {img.caption}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <dialog
      class="m-auto h-dvh max-h-none w-screen max-w-none bg-transparent p-0 backdrop:bg-black/90"
      data-lightbox
      aria-label={t('project.gallery')}
    >
      <div class="flex h-full flex-col">
        <div class="flex items-center justify-between px-4 py-3 text-white/80">
          <span class="font-mono text-xs" data-counter />
          <button type="button" class="p-2 font-mono text-xs hover:text-white" data-close>
            {t('lightbox.close')} ✕
          </button>
        </div>
        <div class="relative flex min-h-0 flex-1 items-center justify-center px-4">
          <img class="max-h-full max-w-full object-contain" alt="" data-image />
          <button
            type="button"
            class="absolute top-1/2 left-2 -translate-y-1/2 p-3 text-2xl text-white/70 hover:text-white"
            aria-label={t('lightbox.prev')}
            data-prev
          >
            ‹
          </button>
          <button
            type="button"
            class="absolute top-1/2 right-2 -translate-y-1/2 p-3 text-2xl text-white/70 hover:text-white"
            aria-label={t('lightbox.next')}
            data-next
          >
            ›
          </button>
        </div>
        <p class="min-h-12 px-4 py-3 text-center text-sm text-white/80" data-caption />
      </div>
    </dialog>
  </section>
)}

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('button[data-index]')];
    let current = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (i: number) => {
      current = (i + thumbs.length) % thumbs.length;
      const thumb = thumbs[current]!;
      img.src = thumb.dataset.full ?? '';
      img.alt = thumb.querySelector('img')?.alt ?? '';
      caption.textContent = thumb.dataset.caption || img.alt;
      counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(thumbs.length).padStart(2, '0')}`;
    };

    thumbs.forEach((thumb, i) =>
      thumb.addEventListener('click', () => {
        opener = thumb;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // Swipe navigation on touch devices.
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0]?.clientX ?? 0), {
      passive: true,
    });
    dialog.addEventListener('touchend', (e) => {
      const dx = (e.changedTouches[0]?.clientX ?? 0) - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>
