---
/**
 * <head> metadata: title, description, canonical, hreflang alternates, Open Graph,
 * Twitter card and optional JSON-LD.
 */
import { site } from '@/data/site';
import { langs, localizePath, ogLocales, stripLang, type Lang } from '@/i18n/utils';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Absolute or root-relative path of the Open Graph image (1200×630). */
  image?: string;
  type?: 'website' | 'article';
  /**
   * False when this localized page falls back to English content: the canonical
   * then points to the English URL and no hreflang alternates are emitted.
   */
  translated?: boolean;
  /** Set on pages that should not be indexed (404). */
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  lang,
  title,
  description,
  image = '/og/default.png',
  type = 'website',
  translated = true,
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
} = Astro.props;

const basePath = stripLang(Astro.url.pathname);
const canonicalLang: Lang = translated ? lang : 'en';
const canonical = new URL(localizePath(basePath, canonicalLang), site.url).href;
const imageUrl = new URL(image, site.url).href;
const fullTitle = basePath === '/' ? `${site.name} · ${title}` : `${title} · ${site.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

{
  translated &&
    !noindex &&
    langs.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(localizePath(basePath, l), site.url).href}
      />
    ))
}
{
  translated && !noindex && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath(basePath, 'en'), site.url).href}
    />
  )
}

<!-- Open Graph / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={ogLocales[lang]} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
