---
/** Page header: the title set huge, then a hairline with the intro from column 4. */
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
  <h1 class="display">{title}</h1>
  {intro && (
    <div class="mt-8 grid-page border-t border-rule pt-4 md:mt-12">
      <p class="max-w-[36ch] text-lead md:col-span-7 md:col-start-4">{intro}</p>
    </div>
  )}
  <slot />
</header>
