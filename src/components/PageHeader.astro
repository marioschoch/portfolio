---
/** Page header: the title set as a monument, with the intro beneath it on the right half. */
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28" data-reveal>
  <h1 class="display">{title}</h1>
  {intro && <p class="mt-10 max-w-[36ch] text-lead md:ml-[50%] md:max-w-[32ch]">{intro}</p>}
  <slot />
</header>
