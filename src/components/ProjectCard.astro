---
/**
 * Project row for the projects index: cover in the label column, then number, title, status, summary
 * and dates · tools on the page grid. Data attributes drive client-side filtering.
 */
import { Image } from 'astro:assets';
import type { LocalizedProject } from '@/lib/content';
import { formatMonth, localizePath, useTranslations, type Lang } from '@/i18n/utils';
import ImagePlaceholder from './ImagePlaceholder.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: LocalizedProject;
  lang: Lang;
  index: number;
  headingLevel?: 'h2' | 'h3';
  /** Eager-load the cover (first card above the fold). */
  eager?: boolean;
}
const { project, lang, index, headingLevel: Heading = 'h2', eager = false } = Astro.props;
const t = useTranslations(lang);
const { data } = project.entry;
---

<article
  class="group relative grid-page gap-y-2 border-b border-rule py-6 md:py-8"
  data-project-card
  data-tags={data.tags.join(' ')}
  data-status={data.status}
>
  <div class="mb-4 md:col-span-3 md:row-span-3 md:mb-0">
    {project.cover ? (
      <Image
        src={project.cover.src}
        alt={project.cover.alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 768px) 25vw, 100vw"
        class="aspect-[16/10] w-full object-cover"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <ImagePlaceholder label={t('project.imagePending')} />
    )}
  </div>
  <span class="col-span-1 num pt-1 md:col-start-4 md:row-start-1 md:pt-2" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
  <Heading class="col-span-3 heading transition-colors duration-150 group-hover:text-accent md:col-span-5 md:col-start-5 md:row-start-1">
    <a href={localizePath(`/projects/${project.id}/`, lang)} class="after:absolute after:inset-0">
      {project.title}
    </a>
  </Heading>
  <p class="col-span-3 col-start-2 md:col-span-3 md:col-start-10 md:row-start-1 md:pt-2">
    <StatusBadge status={data.status} lang={lang} />
  </p>
  <p class="col-span-3 col-start-2 max-w-[60ch] md:col-span-5 md:col-start-5 md:row-start-2">
    {project.summary}
  </p>
  <p class="col-span-3 col-start-2 label md:col-span-3 md:col-start-10 md:row-start-2">
    {formatMonth(data.timeframe.start, lang)} –{' '}
    {data.timeframe.end ? formatMonth(data.timeframe.end, lang) : t('spec.present')}
    <span aria-hidden="true"> · </span>
    <span class="sr-only">{t('spec.tools')}: </span>
    {project.tools.slice(0, 5).join(', ')}
  </p>
</article>
