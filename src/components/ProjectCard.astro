---
/** Project card for grids (home + projects index). Data attributes drive client-side filtering. */
import { Image } from 'astro:assets';
import type { LocalizedProject } from '@/lib/content';
import { formatMonth, localizePath, useTranslations, type Lang } from '@/i18n/utils';
import ImagePlaceholder from './ImagePlaceholder.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: LocalizedProject;
  lang: Lang;
  index: number;
  headingLevel?: 'h2' | 'h3';
  /** Eager-load the cover (first card above the fold). */
  eager?: boolean;
}
const { project, lang, headingLevel: Heading = 'h2', eager = false } = Astro.props;
const t = useTranslations(lang);
const { data } = project.entry;
---

<article
  class="group relative flex flex-col"
  data-project-card
  data-tags={data.tags.join(' ')}
  data-status={data.status}
  data-reveal
>
  <div class="overflow-hidden">
    {project.cover ? (
      <Image
        src={project.cover.src}
        alt={project.cover.alt}
        widths={[480, 720, 960, 1400]}
        sizes="(min-width: 768px) 46vw, 100vw"
        class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out-strong group-hover:scale-[1.03]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <ImagePlaceholder label={t('project.imagePending')} />
    )}
  </div>
  <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <Heading class="text-lead leading-snug">
      <a
        href={localizePath(`/projects/${project.id}/`, lang)}
        class="underline decoration-transparent decoration-2 underline-offset-4 transition-colors after:absolute after:inset-0 group-hover:decoration-current"
      >
        {project.title}
      </a>
    </Heading>
    <StatusBadge status={data.status} lang={lang} />
  </div>
  <p class="mt-3 max-w-[60ch]">{project.summary}</p>
  <p class="mt-3 label">
    {formatMonth(data.timeframe.start, lang)} –{' '}
    {data.timeframe.end ? formatMonth(data.timeframe.end, lang) : t('spec.present')}
    <span aria-hidden="true"> · </span>
    <span class="sr-only">{t('spec.tools')}: </span>
    {project.tools.slice(0, 5).join(', ')}
  </p>
</article>
