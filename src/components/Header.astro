---
/**
 * Site header: wordmark, primary navigation, search (command palette), language and theme switch,
 * on the page grid (name on column 1, navigation from column 7) with a hairline below.
 * On small screens the navigation collapses into a disclosure menu.
 */
import { localizePath, stripLang, useTranslations, type Lang, type UiKey } from '@/i18n/utils';
import { site } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname);

const nav: { key: UiKey; path: string }[] = [
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.cv', path: '/cv/' },
  { key: 'nav.contact', path: '/contact/' },
  { key: 'nav.snake', path: '/snake/' },
];
const isActive = (path: string) => current.startsWith(path);
---

<header class="no-print sticky top-0 z-40 border-b border-rule bg-bg">
  <div class="container-page flex h-14 items-center justify-between gap-4 lg:grid-page">
    <a
      href={localizePath('/', lang)}
      class="link-quiet flex items-baseline gap-2 text-small font-medium lg:col-span-6"
    >
      <span>{site.name}</span>
      <span class="label hidden font-normal sm:inline">ETH · D-MAVT</span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden lg:col-span-4 lg:col-start-7 lg:block">
      <ul class="flex items-center gap-6 text-small">
        {nav.map(({ key, path }) => (
          <li>
            <a
              href={localizePath(path, lang)}
              aria-current={isActive(path) ? 'page' : undefined}
              class="nav-link"
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="-mr-2 flex items-center justify-end lg:col-span-2 lg:col-start-11">
      <button
        type="button"
        data-palette-open
        class="flex h-10 items-center gap-2 px-2 text-fg transition-colors duration-150 hover:text-muted"
        aria-label={t('palette.open')}
        aria-keyshortcuts="Control+K Meta+K"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="m10.5 10.5 4 4" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <kbd class="hidden font-sans text-small xl:inline">⌘K</kbd>
      </button>
      <LangSwitch lang={lang} />
      <ThemeToggle label={t('theme.toggle')} />
      <button
        type="button"
        id="menu-toggle"
        class="flex size-10 items-center justify-center text-fg lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path
            class="menu-icon-open"
            d="M1 5h16M1 9h16M1 13h16"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
          <path
            class="menu-icon-close hidden"
            d="m3 3 12 12M15 3 3 15"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label={t('nav.main')}
    class="hidden border-t border-rule bg-bg lg:hidden"
  >
    <ul class="container-page pb-8">
      {nav.map(({ key, path }) => (
        <li class="border-b border-rule">
          <a
            href={localizePath(path, lang)}
            aria-current={isActive(path) ? 'page' : undefined}
            class="flex items-center justify-between py-4 heading text-fg aria-[current=page]:text-accent"
          >
            {t(key)}
            <span class="text-lead" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  @reference '../styles/global.css';
  /* Hover: a hairline underline. Current page: the red underline. */
  .nav-link {
    @apply block py-1 text-fg underline decoration-transparent decoration-1 underline-offset-[6px] transition-[text-decoration-color] duration-150 hover:decoration-current;
  }
  .nav-link[aria-current='page'] {
    @apply decoration-accent decoration-2;
  }
</style>

<script>
  // Mobile menu disclosure.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
