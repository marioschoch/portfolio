---
/**
 * Site header: wordmark, primary navigation, search (command palette), language and theme switch.
 * On small screens the navigation collapses into a disclosure menu.
 */
import { localizePath, stripLang, useTranslations, type Lang, type UiKey } from '@/i18n/utils';
import { site } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname);

const nav: { key: UiKey; path: string }[] = [
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.updates', path: '/updates/' },
  { key: 'nav.cv', path: '/cv/' },
  { key: 'nav.about', path: '/about/' },
  { key: 'nav.contact', path: '/contact/' },
  { key: 'nav.snake', path: '/snake/' },
];
const isActive = (path: string) => current.startsWith(path);
---

<header class="no-print sticky top-0 z-40 border-b border-rule bg-bg/90 backdrop-blur-sm">
  <div class="container-page flex h-14 items-center gap-6">
    <a
      href={localizePath('/', lang)}
      class="group flex items-baseline gap-2.5 font-semibold tracking-tight"
    >
      <span>{site.name}</span>
      <span class="label hidden transition-colors group-hover:text-fg sm:inline">ETH · D-MAVT</span>
    </a>

    <nav aria-label={t('nav.main')} class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {nav.map(({ key, path }) => (
          <li>
            <a
              href={localizePath(path, lang)}
              aria-current={isActive(path) ? 'page' : undefined}
              class="rounded-sm px-2.5 py-1.5 text-fg-soft transition-colors hover:text-fg aria-[current=page]:text-fg aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[1.15rem]"
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <button
        type="button"
        data-palette-open
        class="flex h-8 items-center gap-2 rounded-sm border border-rule px-2 text-muted transition-colors hover:border-rule-strong hover:text-fg"
        aria-label={t('palette.open')}
        aria-keyshortcuts="Control+K Meta+K"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.75" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="m10.5 10.5 3.5 3.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          ></path>
        </svg>
        <kbd class="hidden font-mono text-2xs sm:inline">⌘K</kbd>
      </button>
      <LangSwitch lang={lang} />
      <ThemeToggle label={t('theme.toggle')} />
      <button
        type="button"
        id="menu-toggle"
        class="flex size-8 items-center justify-center rounded-sm text-fg-soft hover:text-fg md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path
            class="menu-icon-open"
            d="M2 5h14M2 9h14M2 13h14"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
          <path
            class="menu-icon-close hidden"
            d="m4 4 10 10M14 4 4 14"
            stroke="currentColor"
            stroke-width="1.5"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={t('nav.main')} class="hidden border-t border-rule md:hidden">
    <ul class="container-page py-2">
      {nav.map(({ key, path }) => (
        <li>
          <a
            href={localizePath(path, lang)}
            aria-current={isActive(path) ? 'page' : undefined}
            class="flex items-center justify-between border-b border-rule py-3 text-fg-soft last:border-0 aria-[current=page]:text-fg"
          >
            {t(key)}
            <span class="label" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Mobile menu disclosure.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
