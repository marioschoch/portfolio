---
/**
 * Site header: wordmark, primary navigation, search (command palette), language and theme switch.
 * On small screens the navigation collapses into a disclosure menu.
 */
import { localizePath, stripLang, useTranslations, type Lang, type UiKey } from '@/i18n/utils';
import { site } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = stripLang(Astro.url.pathname);

const nav: { key: UiKey; path: string }[] = [
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.updates', path: '/updates/' },
  { key: 'nav.cv', path: '/cv/' },
  { key: 'nav.about', path: '/about/' },
  { key: 'nav.contact', path: '/contact/' },
  { key: 'nav.snake', path: '/snake/' },
];
const isActive = (path: string) => current.startsWith(path);
---

<header class="no-print sticky top-0 z-40 bg-bg">
  <div class="container-page flex h-16 items-center gap-6">
    <a
      href={localizePath('/', lang)}
      class="group flex items-baseline gap-3 text-[1.0625rem] font-semibold tracking-tight"
    >
      <span>{site.name}</span>
      <span class="label hidden font-normal transition-colors group-hover:text-fg lg:inline">
        ETH · D-MAVT
      </span>
    </a>

    <nav aria-label={t('nav.main')} class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map(({ key, path }) => (
          <li>
            <a
              href={localizePath(path, lang)}
              aria-current={isActive(path) ? 'page' : undefined}
              class="nav-link px-2.5 py-1.5"
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="-mr-2.5 ml-auto flex items-center gap-1 lg:ml-2">
      <button
        type="button"
        data-palette-open
        class="flex h-10 items-center gap-2 px-2 text-muted transition-colors hover:text-fg"
        aria-label={t('palette.open')}
        aria-keyshortcuts="Control+K Meta+K"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.75" stroke="currentColor" stroke-width="1.6"></circle>
          <path
            d="m10.5 10.5 3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
        <kbd class="hidden font-sans text-small xl:inline">⌘K</kbd>
      </button>
      <LangSwitch lang={lang} />
      <ThemeToggle label={t('theme.toggle')} />
      <button
        type="button"
        id="menu-toggle"
        class="flex size-10 items-center justify-center text-fg lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
      >
        <svg width="20" height="20" viewBox="0 0 18 18" aria-hidden="true">
          <path
            class="menu-icon-open"
            d="M2 5h14M2 9h14M2 13h14"
            stroke="currentColor"
            stroke-width="1.6"
          ></path>
          <path
            class="menu-icon-close hidden"
            d="m4 4 10 10M14 4 4 14"
            stroke="currentColor"
            stroke-width="1.6"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={t('nav.main')} class="hidden bg-bg lg:hidden">
    <ul class="container-page pt-2 pb-8">
      {nav.map(({ key, path }) => (
        <li>
          <a
            href={localizePath(path, lang)}
            aria-current={isActive(path) ? 'page' : undefined}
            class="flex items-center justify-between py-2 heading text-fg aria-[current=page]:text-muted"
          >
            {t(key)}
            <span class="text-lead" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  @reference '../styles/global.css';
  /* Current page: a filled block in the ink. Hover: a step in tone. */
  .nav-link {
    @apply relative block text-fg transition-colors hover:bg-surface;
  }
  .nav-link[aria-current='page'] {
    @apply bg-fg text-bg hover:bg-fg;
  }
</style>

<script>
  // Mobile menu disclosure.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
