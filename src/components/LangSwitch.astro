---
/** EN/DE switch. Links to the same page in the other language (pages always exist in both). */
import { langs, localizePath, stripLang, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// On the 404 page there is no equivalent page to switch to, so link to the home pages.
const stripped = stripLang(Astro.url.pathname);
const basePath = stripped.startsWith('/404') ? '/' : stripped;
---

<ul class="flex items-center text-small" aria-label={t('lang.label')}>
  {langs.map((l) => (
    <li>
      <a
        href={localizePath(basePath, l)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'true' : undefined}
        class="flex h-10 items-center px-2 text-muted uppercase transition-colors duration-150 hover:text-fg aria-[current=true]:font-medium aria-[current=true]:text-fg"
      >
        {l}
      </a>
    </li>
  ))}
</ul>
