---
/**
 * Site footer on the page grid: the link to the contact page in the label column, the contact
 * links from column 4, and a row of credits below a hairline.
 */
import { site } from '@/data/site';
import { isoDate, localizePath, useTranslations, type Lang } from '@/i18n/utils';
import ObfuscatedEmail from './ObfuscatedEmail.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const buildDate = isoDate(new Date());
---

<footer class="no-print border-t border-rule">
  <div class="container-page grid-page gap-y-6 pt-8 pb-12 md:pt-12 md:pb-16">
    <p class="md:col-span-3">
      <a
        href={localizePath('/contact/', lang)}
        class="link-quiet inline-flex items-baseline gap-2 heading"
      >
        {t('nav.contact')}
        <span aria-hidden="true">→</span>
      </a>
    </p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 md:col-span-9 md:col-start-4 md:pt-2">
      <li>
        <ObfuscatedEmail class="link" label={t('contact.email')} />
      </li>
      <li>
        <a href={site.links.linkedin} class="link" rel="me noopener">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.links.github} class="link" rel="me noopener">
          GitHub
        </a>
      </li>
      <li>
        <a href={localizePath('/cv/', lang)} class="link">
          {t('nav.cv')}
        </a>
      </li>
    </ul>
  </div>

  <div class="container-page pb-8">
    <div class="grid-page gap-y-1 border-t border-rule pt-2 text-small text-muted">
      <p class="md:col-span-3">
        © {year} {site.name}
      </p>
      <p class="md:col-span-9 md:col-start-4">
        Build <time datetime={buildDate}>{buildDate}</time> · {t('footer.source')}
      </p>
    </div>
  </div>
</footer>
