---
/** Site footer with contact links and a small spec-sheet style build stamp. */
import { site } from '@/data/site';
import { isoDate, localizePath, useTranslations, type Lang } from '@/i18n/utils';
import ObfuscatedEmail from './ObfuscatedEmail.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const buildDate = isoDate(new Date());
---

<footer class="no-print mt-24 border-t border-rule">
  <div class="container-page grid gap-8 py-10 text-sm text-fg-soft sm:grid-cols-[1fr_auto] sm:items-end">
    <div class="space-y-3">
      <p class="font-semibold text-fg">{site.name}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li>
          <ObfuscatedEmail class="hover:text-fg" label={t('contact.email')} />
        </li>
        <li>
          <a href={site.links.linkedin} class="hover:text-fg" rel="me noopener">
            LinkedIn
          </a>
        </li>
        <li>
          <a href={site.links.github} class="hover:text-fg" rel="me noopener">
            GitHub
          </a>
        </li>
        <li>
          <a href="/rss.xml" class="hover:text-fg">
            {t('footer.rss')}
          </a>
        </li>
        <li>
          <a href={localizePath('/cv/', lang)} class="hover:text-fg">
            {t('nav.cv')}
          </a>
        </li>
      </ul>
    </div>
    <dl class="grid w-fit grid-cols-[auto_auto] gap-x-4 gap-y-1 font-mono text-2xs text-muted sm:ml-auto">
      <dt>©</dt>
      <dd>
        {year} {site.name}
      </dd>
      <dt>BUILD</dt>
      <dd>
        <time datetime={buildDate}>{buildDate}</time>
      </dd>
      <dt>STACK</dt>
      <dd>{t('footer.source')}</dd>
    </dl>
  </div>
</footer>
