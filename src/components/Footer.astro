---
/**
 * Site footer: one field in the inverse colours. A large link to the contact page, the
 * contact links, a row of credits, and the name returning at full width, cropped by the
 * bottom edge.
 */
import { site } from '@/data/site';
import { isoDate, localizePath, useTranslations, type Lang } from '@/i18n/utils';
import ObfuscatedEmail from './ObfuscatedEmail.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const buildDate = isoDate(new Date());
---

<footer class="no-print relative overflow-hidden bg-field text-field-ink">
  <div class="container-page grid gap-12 pt-20 pb-10 sm:pt-28 md:grid-cols-12" data-reveal>
    <p class="md:col-span-7">
      <a
        href={localizePath('/contact/', lang)}
        class="group inline-flex items-baseline gap-4 text-display font-semibold tracking-[-0.05em]"
      >
        {t('nav.contact')}
        <span
          class="inline-block text-[0.6em] transition-transform duration-300 ease-out-strong group-hover:translate-x-3"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-lead md:col-span-4 md:col-start-9 md:flex-col md:self-end">
      <li>
        <ObfuscatedEmail class="footer-link" label={t('contact.email')} />
      </li>
      <li>
        <a href={site.links.linkedin} class="footer-link" rel="me noopener">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.links.github} class="footer-link" rel="me noopener">
          GitHub
        </a>
      </li>
      <li>
        <a href={localizePath('/rss/', lang)} class="footer-link">
          {t('footer.rss')}
        </a>
      </li>
      <li>
        <a href={localizePath('/cv/', lang)} class="footer-link">
          {t('nav.cv')}
        </a>
      </li>
    </ul>
  </div>

  <div class="container-page flex flex-wrap justify-between gap-x-8 gap-y-1 pt-6 text-small text-field-muted">
    <p>
      © {year} {site.name}
    </p>
    <p>
      Build <time datetime={buildDate}>{buildDate}</time> · {t('footer.source')}
    </p>
  </div>

  <p
    class="pointer-events-none -mb-[0.24em] pl-[0.03em] text-[15vw] leading-[0.95] font-semibold tracking-[-0.06em] whitespace-nowrap select-none sm:pl-[0.02em]"
    aria-hidden="true"
  >
    {site.name}
  </p>
</footer>

<style>
  @reference '../styles/global.css';
  .footer-link {
    @apply underline decoration-transparent decoration-1 underline-offset-4 transition-[text-decoration-color] hover:decoration-current;
  }
</style>
