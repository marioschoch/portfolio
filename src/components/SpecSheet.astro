---
/**
 * Spec sheet of a project: role, timeframe, team, status, tools, links, as label/value rows
 * divided by hairlines (placed in the label column of the project page).
 * Rendered as a definition list for correct semantics.
 */
import type { LocalizedProject } from '@/lib/content';
import { formatMonth, isoDate, useTranslations, type Lang, type UiKey } from '@/i18n/utils';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: LocalizedProject;
  lang: Lang;
  class?: string;
}
const { project, lang, class: className } = Astro.props;
const t = useTranslations(lang);
const { data } = project.entry;

const links = (
  [
    ['github', 'link.github'],
    ['report', 'link.report'],
    ['video', 'link.video'],
    ['website', 'link.website'],
  ] as const
)
  .map(([key, label]) => ({ href: data.links[key], label: t(label as UiKey) }))
  .filter((l): l is { href: string; label: string } => Boolean(l.href));
---

<dl class:list={['border-t border-rule text-small', className]}>
  <div class="spec-row">
    <dt class="label">{t('spec.role')}</dt>
    <dd class="spec-value">{project.role}</dd>
  </div>
  <div class="spec-row">
    <dt class="label">{t('spec.timeframe')}</dt>
    <dd class="spec-value">
      <time datetime={isoDate(data.timeframe.start)}>
        {formatMonth(data.timeframe.start, lang)}
      </time>
      –
      {data.timeframe.end ? (
        <time datetime={isoDate(data.timeframe.end)}>{formatMonth(data.timeframe.end, lang)}</time>
      ) : (
        t('spec.present')
      )}
    </dd>
  </div>
  <div class="spec-row">
    <dt class="label">{t('spec.team')}</dt>
    <dd class="spec-value">
      {data.teamSize === 1 ? t('spec.teamSolo') : `${data.teamSize} ${t('spec.teamPeople')}`}
    </dd>
  </div>
  <div class="spec-row">
    <dt class="label">{t('spec.status')}</dt>
    <dd class="spec-value">
      <StatusBadge status={data.status} lang={lang} />
    </dd>
  </div>
  <div class="spec-row">
    <dt class="label">{t('spec.tools')}</dt>
    <dd class="spec-value">{project.tools.join(', ')}</dd>
  </div>
  {links.length > 0 && (
    <div class="pt-4">
      <dt class="sr-only">{t('spec.links')}</dt>
      <dd>
        <ul class="flex flex-col gap-2">
          {links.map((l) => (
            <li>
              <a href={l.href} class="link" rel="noopener">
                {l.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  )}
</dl>

<style>
  @reference '../styles/global.css';
  .spec-row {
    @apply grid grid-cols-3 gap-x-4 border-b border-rule py-2;
  }
  .spec-value {
    @apply col-span-2 text-fg;
  }
</style>
