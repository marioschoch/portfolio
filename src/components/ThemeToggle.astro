---
/** Light/dark toggle. The initial theme is set by ThemeScript.astro before paint. */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="flex size-8 items-center justify-center rounded-sm text-fg-soft transition-colors hover:text-fg"
  aria-label={label}
  aria-pressed="false"
>
  <!-- Sun (shown in dark mode) -->
  <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <!-- Moon (shown in light mode) -->
  <svg class="block dark:hidden" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
    <path
      d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    sync();
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: theme still switches for this page */
      }
      sync();
    });
  }
</script>
