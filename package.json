{
  "name": "marioschoch-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio of Mario Schoch — static Astro site, deployed via FTPS/SFTP to Plesk hosting.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/csp-hashes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "todos": "grep -rn --color=always \"TODO\" src docs README.md || true",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google/model-viewer": "^4.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "reading-time": "^1.5.0",
    "satori": "^0.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "astro-eslint-parser": "^3.2.0",
    "basic-ftp": "^6.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ssh2-sftp-client": "^12.1.1",
    "typescript-eslint": "^8.71.2"
  }
}
